package layouts

import "github.com/pi-bmc/nanokvm-app/server/components"

// Base renders the common HTML document shell. The `dark` class on <html>
// activates the dark theme tokens (defined in globals.css).
//
// The shadcn-templ components are vendored into server/components, so
// Tailwind scans their utility classes during the normal build — output.css
// is complete. Component behaviour ships as one JS bundle rendered by
// components.Scripts() and served by components.ScriptsHandler() (mounted in
// the router).
templ Base(title string, showNav bool, onDocsPage bool) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		<head>
			<meta charset="UTF-8"/>
			<link rel="icon" type="image/x-icon" href="/img/favicon.ico"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/css/output.css"/>
			@components.Scripts()
			@authHelperScript()
		</head>
		<body class="min-h-screen">
			<div class="flex h-screen flex-col">
				if showNav {
					@components.Navbar(onDocsPage)
				}
				<main class="min-h-0 flex-1 overflow-hidden">
					{ children... }
				</main>
			</div>
			if showNav {
				// SettingsDialog and EEPROMDialog live at the root so triggers
				// scattered through the page share their DOM scope. They have
				// no on-page footprint when their triggers aren't clicked.
				@components.SettingsDialog()
				@components.EEPROMDialog()
			}
		</body>
	</html>
}

// authHelperScript exposes cookie + auth-header helpers used by every page's
// inline fetch() calls. Defined early so handlers in <body> can call them.
templ authHelperScript() {
	<script>
		function getCookie(name) {
			const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
			return match ? decodeURIComponent(match[2]) : null;
		}
		function getAuthHeaders() {
			const token = getCookie('nano-kvm-token') || '';
			return { 'Content-Type': 'application/json', 'token': token };
		}
		async function apiGet(url) {
			return (await fetch(url, { headers: getAuthHeaders() })).json();
		}
		async function apiPost(url, body) {
			return (await fetch(url, {
				method: 'POST',
				headers: getAuthHeaders(),
				body: body ? JSON.stringify(body) : undefined,
			})).json();
		}
	</script>
}
