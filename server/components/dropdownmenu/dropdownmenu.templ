package dropdownmenu

import (
	"context"
	"strconv"

	"github.com/pi-bmc/nanokvm-app/server/components/icon"
	"github.com/pi-bmc/nanokvm-app/server/utils"
)

type ItemVariant string

const (
	ItemVariantDefault     ItemVariant = "default"
	ItemVariantDestructive ItemVariant = "destructive"
)

type Side string

const (
	SideTop    Side = "top"
	SideRight  Side = "right"
	SideBottom Side = "bottom"
	SideLeft   Side = "left"
)

type Align string

const (
	AlignStart  Align = "start"
	AlignCenter Align = "center"
	AlignEnd    Align = "end"
)

type ctxKey string

const idKey ctxKey = "dropdownmenuID"

// menuID returns the id shared by Root, Trigger and Content via ctx.
func menuID(ctx context.Context) string {
	if id, ok := ctx.Value(idKey).(string); ok {
		return id
	}
	return ""
}

// Trigger returns the attributes that turn any element (usually a button)
// into the menu trigger — the asChild equivalent: no wrapper element, so the
// trigger composes cleanly inside ButtonGroup and friends.
func Trigger(ctx context.Context) templ.Attributes {
	return templ.Attributes{
		"data-tui-dropdownmenu-trigger": true,
		"aria-controls":                 menuID(ctx),
		"aria-haspopup":                 "menu",
		"aria-expanded":                 "false",
	}
}

type Props struct {
	ID string
}

type ContentProps struct {
	Class      string
	Attributes templ.Attributes
	// Side of the trigger the menu opens on. Defaults to bottom; flips
	// automatically when there is no room.
	Side Side
	// Align along the trigger edge. Defaults to start.
	Align Align
	// SideOffset is the gap to the trigger in px. Defaults to 4.
	SideOffset int
	// AlignOffset shifts the menu along the aligned edge in px. Defaults to 0.
	AlignOffset int
}

type GroupProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type LabelProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Inset      bool
}

type ItemProps struct {
	ID           string
	Class        string
	Attributes   templ.Attributes
	Variant      ItemVariant
	Disabled     bool
	Inset        bool
	Href         string
	Target       string
	DisableCloseOnClick bool
}

type CheckboxItemProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Checked    bool
	Disabled   bool
}

type RadioGroupProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type RadioItemProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Value      string
	Checked    bool
	Disabled   bool
}

type SeparatorProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type ShortcutProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type SubProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type SubTriggerProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Inset      bool
}

type SubContentProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// Items highlight via real focus (Base UI menus move focus to the item under
// the pointer and with the arrow keys), so there are no hover: styles here.
// 1:1 base/ui/dropdown-menu.tsx DropdownMenuItem, the look comes from
//; the inset padding keys on the data-inset attribute.
func itemClasses(disabled bool) string {
	return utils.CN(
		"focus:bg-accent focus:text-accent-foreground data-[variant=destructive]:text-destructive data-[variant=destructive]:focus:bg-destructive/10 dark:data-[variant=destructive]:focus:bg-destructive/20 data-[variant=destructive]:focus:text-destructive data-[variant=destructive]:*:[svg]:text-destructive not-data-[variant=destructive]:focus:**:text-accent-foreground min-h-7 gap-2 rounded-md px-2 py-1 text-xs/relaxed data-inset:pl-7.5 [&_svg:not([class*='size-'])]:size-3.5 group/dropdown-menu-item relative flex cursor-default items-center outline-hidden select-none data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0",
		// Native <a>/<button> wiring instead of Base UI's div items.
		"w-full text-left",
		map[string]bool{"pointer-events-none opacity-50": disabled},
	)
}

// 1:1 base/ui/dropdown-menu.tsx DropdownMenuCheckboxItem/RadioItem, cnClass is
// or.
func checkItemClasses(cnClass string, disabled bool) string {
	return utils.CN(
		cnClass+" relative flex cursor-default items-center outline-hidden select-none data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0",
		// Native <button> wiring: Base UI unmounts the indicator when unchecked,
		// our indicator toggles on the checked state via the group instead.
		"group/dmitem w-full text-left",
		map[string]bool{"pointer-events-none opacity-50": disabled},
	)
}

// Root renders no element: it only generates the id that links Trigger and
// Content (via ctx), so the trigger stays a direct child of its layout.
templ DropdownMenu(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.ID == "" {
		{{ p.ID = utils.RandomID() }}
	}
	{{ ctx = context.WithValue(ctx, idKey, p.ID) }}
	{ children... }
}

// PortalProps is the reference Portal's surface: the portal node renders
// no visible element of its own.
type PortalProps struct {
	Attributes templ.Attributes
}

// Portal is 1:1 the reference Portal slot: inert until the script portals
// the content to <body> at init.
templ Portal(props ...PortalProps) {
	{{ var p PortalProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<template data-tui-dropdownmenu-portal { p.Attributes... }>
		{ children... }
	</template>
}

templ Content(props ...ContentProps) {
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Side == "" {
		{{ p.Side = SideBottom }}
	}
	if p.Align == "" {
		{{ p.Align = AlignStart }}
	}
	if p.SideOffset == 0 {
		{{ p.SideOffset = 4 }}
	}
	// Inert until the script portals it to <body> at init, so the SSRd
	// content never participates in layout or sibling CSS.
	@Portal() {
	<div
		id={ menuID(ctx) }
		data-tui-dropdownmenu-content
		data-tui-dropdownmenu-side={ string(p.Side) }
		data-tui-dropdownmenu-align={ string(p.Align) }
		data-tui-dropdownmenu-side-offset={ strconv.Itoa(p.SideOffset) }
		data-tui-dropdownmenu-align-offset={ strconv.Itoa(p.AlignOffset) }
		data-state="closed"
		popover="manual"
		class="pointer-events-none isolate fixed inset-auto z-50 m-0 overflow-visible border-0 bg-transparent p-0"
	>
		<div
			data-slot="dropdown-menu-content"
			data-tui-dropdownmenu-popup
			data-state="closed"
			role="menu"
			tabindex="-1"
			class={
				utils.CN(
					// 1:1 base/ui/dropdown-menu.tsx DropdownMenuContent, the look comes
					// from (animations key on our data-state
					// attribute). The --available-height/--anchor-width/--transform-origin
					// variables become our JS variable names.
					"data-open:animate-in data-closed:animate-out data-closed:fade-out-0 data-open:fade-in-0 data-closed:zoom-out-95 data-open:zoom-in-95 data-[side=bottom]:slide-in-from-top-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 ring-foreground/10 bg-popover text-popover-foreground min-w-32 rounded-lg p-1 shadow-md ring-1 duration-100 data-[side=inline-start]:slide-in-from-right-2 data-[side=inline-end]:slide-in-from-left-2 z-50 max-h-(--tui-dropdownmenu-available-height) w-(--tui-dropdownmenu-anchor-width) origin-(--tui-dropdownmenu-transform-origin) overflow-x-hidden overflow-y-auto outline-none data-closed:overflow-hidden",
					// JS wiring: the positioner wrapper is pointer-events-none, and the
					// popup stays mounted after animate-out until hidePopover runs.
					"pointer-events-auto relative isolate data-closed:fill-mode-forwards",
					p.Class,
				),
			}
			{ p.Attributes... }
		>
			{ children... }
		</div>
	</div>
	}
}

templ Group(props ...GroupProps) {
	{{ var p GroupProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		role="group"
		data-slot="dropdown-menu-group"
		class={ utils.CN("", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Label(props ...LabelProps) {
	{{ var p LabelProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="dropdown-menu-label"
		data-inset?={ p.Inset }
		class={ utils.CN("text-muted-foreground px-2 py-1.5 text-xs data-inset:pl-7.5", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Item(props ...ItemProps) {
	{{ var p ItemProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Variant == "" {
		{{ p.Variant = ItemVariantDefault }}
	}
	if p.Href != "" {
		<a
			if p.ID != "" {
				id={ p.ID }
			}
			href={ templ.SafeURL(p.Href) }
			if p.Target != "" {
				target={ p.Target }
			}
			data-slot="dropdown-menu-item"
			data-variant={ string(p.Variant) }
			data-inset?={ p.Inset }
			data-tui-dropdownmenu-item
			if p.DisableCloseOnClick {
				data-tui-dropdownmenu-disable-close-on-click="true"
			}
			if p.Disabled {
				aria-disabled="true"
			}
			role="menuitem"
			class={ utils.CN(itemClasses(p.Disabled), p.Class) }
			{ p.Attributes... }
		>
			{ children... }
		</a>
	} else {
		<button
			if p.ID != "" {
				id={ p.ID }
			}
			type="button"
			data-slot="dropdown-menu-item"
			data-variant={ string(p.Variant) }
			data-inset?={ p.Inset }
			data-tui-dropdownmenu-item
			if p.DisableCloseOnClick {
				data-tui-dropdownmenu-disable-close-on-click="true"
			}
			disabled?={ p.Disabled }
			role="menuitem"
			class={ utils.CN(itemClasses(p.Disabled), p.Class) }
			{ p.Attributes... }
		>
			{ children... }
		</button>
	}
}

templ CheckboxItem(props ...CheckboxItemProps) {
	{{ var p CheckboxItemProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<button
		if p.ID != "" {
			id={ p.ID }
		}
		type="button"
		data-slot="dropdown-menu-checkbox-item"
		data-tui-dropdownmenu-checkbox-item
		role="menuitemcheckbox"
		if p.Checked {
			data-state="checked"
			aria-checked="true"
		} else {
			data-state="unchecked"
			aria-checked="false"
		}
		disabled?={ p.Disabled }
		class={ utils.CN(checkItemClasses("focus:bg-accent focus:text-accent-foreground focus:**:text-accent-foreground min-h-7 gap-2 rounded-md py-1.5 pr-8 pl-2 text-xs data-inset:pl-7.5 [&_svg:not([class*='size-'])]:size-3.5", p.Disabled), p.Class) }
		{ p.Attributes... }
	>
		<span
			data-slot="dropdown-menu-checkbox-item-indicator"
			class="absolute right-2 flex items-center justify-center pointer-events-none opacity-0 group-data-[state=checked]/dmitem:opacity-100"
		>
			@icon.Check()
		</span>
		{ children... }
	</button>
}

templ RadioGroup(props ...RadioGroupProps) {
	{{ var p RadioGroupProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		role="group"
		data-slot="dropdown-menu-radio-group"
		data-tui-dropdownmenu-radio-group
		class={ utils.CN("", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ RadioItem(props ...RadioItemProps) {
	{{ var p RadioItemProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<button
		if p.ID != "" {
			id={ p.ID }
		}
		type="button"
		data-slot="dropdown-menu-radio-item"
		data-tui-dropdownmenu-radio-item
		if p.Value != "" {
			data-tui-dropdownmenu-radio-value={ p.Value }
		}
		role="menuitemradio"
		if p.Checked {
			data-state="checked"
			aria-checked="true"
		} else {
			data-state="unchecked"
			aria-checked="false"
		}
		disabled?={ p.Disabled }
		class={ utils.CN(checkItemClasses("focus:bg-accent focus:text-accent-foreground focus:**:text-accent-foreground min-h-7 gap-2 rounded-md py-1.5 pr-8 pl-2 text-xs data-inset:pl-7.5 [&_svg:not([class*='size-'])]:size-3.5", p.Disabled), p.Class) }
		{ p.Attributes... }
	>
		<span
			data-slot="dropdown-menu-radio-item-indicator"
			class="absolute right-2 flex items-center justify-center pointer-events-none opacity-0 group-data-[state=checked]/dmitem:opacity-100"
		>
			@icon.Check()
		</span>
		{ children... }
	</button>
}

templ Separator(props ...SeparatorProps) {
	{{ var p SeparatorProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		role="separator"
		data-slot="dropdown-menu-separator"
		class={ utils.CN("bg-border/50 -mx-1 my-1 h-px", p.Class) }
		{ p.Attributes... }
	></div>
}

templ Shortcut(props ...ShortcutProps) {
	{{ var p ShortcutProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<span
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="dropdown-menu-shortcut"
		class={ utils.CN("text-muted-foreground group-focus/dropdown-menu-item:text-accent-foreground ml-auto text-[0.625rem] tracking-widest", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</span>
}

templ Sub(props ...SubProps) {
	{{ var p SubProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="dropdown-menu-sub"
		data-tui-dropdownmenu-sub
		class={ utils.CN("", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ SubTrigger(props ...SubTriggerProps) {
	{{ var p SubTriggerProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<button
		if p.ID != "" {
			id={ p.ID }
		}
		type="button"
		data-slot="dropdown-menu-sub-trigger"
		data-inset?={ p.Inset }
		data-tui-dropdownmenu-sub-trigger
		data-state="closed"
		role="menuitem"
		aria-haspopup="menu"
		class={
			utils.CN(
				// 1:1 base/ui/dropdown-menu.tsx DropdownMenuSubTrigger, the look comes
				// from. Base UI keys the open highlight on
				// data-popup-open, our JS sets data-state=open, which the data-open
				// variants inside the cn class match as well.
				"focus:bg-accent focus:text-accent-foreground data-open:bg-accent data-open:text-accent-foreground not-data-[variant=destructive]:focus:**:text-accent-foreground min-h-7 gap-2 rounded-md px-2 py-1 text-xs data-inset:pl-7.5 [&_svg:not([class*='size-'])]:size-3.5 flex cursor-default items-center outline-hidden select-none data-popup-open:bg-accent data-popup-open:text-accent-foreground [&_svg]:pointer-events-none [&_svg]:shrink-0",
				// Native <button> wiring instead of Base UI's div items.
				"w-full text-left",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
		@icon.ChevronRight(icon.Props{Class: "ml-auto"})
	</button>
}

templ SubContent(props ...SubContentProps) {
	{{ var p SubContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="dropdown-menu-sub-content"
		data-tui-dropdownmenu-sub-content
		data-state="closed"
		role="menu"
		tabindex="-1"
		class={
			utils.CN(
				// 1:1 base/ui/dropdown-menu.tsx DropdownMenuSubContent: the sub content
				// is the content plus and w-auto, the look
				// comes from the cn classes (animations key on our data-state attribute).
				"data-open:animate-in data-closed:animate-out data-closed:fade-out-0 data-open:fade-in-0 data-closed:zoom-out-95 data-open:zoom-in-95 data-[side=bottom]:slide-in-from-top-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 data-[side=inline-start]:slide-in-from-right-2 data-[side=inline-end]:slide-in-from-left-2 data-open:animate-in data-closed:animate-out data-closed:fade-out-0 data-open:fade-in-0 data-closed:zoom-out-95 data-open:zoom-in-95 data-[side=bottom]:slide-in-from-top-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 ring-foreground/10 bg-popover text-popover-foreground min-w-32 rounded-lg p-1 shadow-md ring-1 duration-100 z-50 w-auto origin-(--tui-dropdownmenu-transform-origin) overflow-x-hidden overflow-y-auto outline-none data-closed:overflow-hidden",
				// JS wiring: floatingui positions the sub content as a fixed layer and
				// toggles the hidden class around the exit animation.
				"hidden fixed inset-auto left-0 top-0 data-closed:fill-mode-forwards",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
	</div>
}
