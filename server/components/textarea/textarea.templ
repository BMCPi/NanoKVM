package textarea

import (
	"github.com/pi-bmc/nanokvm-app/server/utils"
	"strconv"
)

type Props struct {
	ID          string
	Class       string
	Attributes  templ.Attributes
	Name        string
	Value       string
	Form        string
	Placeholder string
	Rows        int
	Disabled    bool
	ReadOnly    bool
}

templ Textarea(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.ID == "" {
		{{ p.ID = utils.RandomID() }}
	}
	<textarea
		id={ p.ID }
		if _, hasSlot := p.Attributes["data-slot"]; !hasSlot {
			data-slot="textarea"
		}
		if p.Name != "" {
			name={ p.Name }
		}
		if p.Form != "" {
			form={ p.Form }
		}
		if p.Placeholder != "" {
			placeholder={ p.Placeholder }
		}
		if p.Rows > 0 {
			rows={ strconv.Itoa(p.Rows) }
		}
		disabled?={ p.Disabled }
		readonly?={ p.ReadOnly }
		class={
			utils.CN(
				// 1:1 base/ui/textarea.tsx: structure lives here, the look comes
				// from the active style-*.css via.
				"border-input bg-input/20 dark:bg-input/30 focus-visible:border-ring focus-visible:ring-ring/30 aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive dark:aria-invalid:border-destructive/50 resize-none rounded-md border px-2 py-2 text-sm transition-colors focus-visible:ring-2 aria-invalid:ring-2 md:text-xs/relaxed flex field-sizing-content min-h-16 w-full outline-none placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-50",
				p.Class,
			),
		}
		{ p.Attributes... }
	>{ p.Value }</textarea>
}
