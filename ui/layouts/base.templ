package layouts

import (
	"github.com/pi-bmc/nanokvm-app/ui/components"
	"github.com/pi-bmc/nanokvm-app/ui/components/toast"
)

// Base renders the common HTML document shell. The `dark` class on <html>
// activates the dark theme tokens (defined in globals.css).
//
// The shadcn-templ components are vendored into ui/components, so
// Tailwind scans their utility classes during the normal build — output.css
// is complete. Component behaviour ships as one JS bundle rendered by
// components.Scripts() and served by components.ScriptsHandler() (mounted in
// the router).
templ Base(title string, showNav bool, onDocsPage bool) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		<head>
			<meta charset="UTF-8"/>
			<link rel="icon" type="image/x-icon" href="/img/favicon.ico"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/css/output.css"/>
			// htmx drives every server-rendered update: the hx-* attributes on
			// the components request the fragment routes in ui/fragments.go and
			// swap the returned markup in. Vendored (v2.0.10) rather than loaded
			// from a CDN — the BMC has no outbound internet on a closed
			// management network. Deferred like the component bundle; htmx
			// initializes on DOMContentLoaded either way.
			<script defer nonce={ templ.GetNonce(ctx) } src="/js/htmx.min.js"></script>
			@components.Scripts()
			@authHelperScript()
		</head>
		<body class="min-h-screen">
			<div class="flex h-screen flex-col">
				if showNav {
					@components.Navbar(onDocsPage)
					if !onDocsPage {
						// The virtual keyboard is a fixed bottom sheet that
						// slides up over the console panes, serving the HDMI
						// and serial consoles alike. Being position:fixed it
						// is out of flow — its spot in the column is
						// irrelevant to layout.
						@components.VirtualKeyboard()
					}
				}
				<main class="min-h-0 flex-1 overflow-hidden">
					{ children... }
				</main>
			</div>
			if showNav {
				// SettingsDialog lives at the root so triggers scattered
				// through the page share its DOM scope. The dialogs have no
				// on-page footprint when their triggers aren't clicked.
				@components.SettingsDialog()
				@components.ConfirmDialog()
			}
			// Toast viewport for tui.toast.add() — mounted on every page so
			// auth pages can surface errors the same way as the dashboard.
			@toast.Toaster()
			// Wires htmx's confirm/trigger/error events to the dialog and
			// toast components above, so fragments never ship their own glue.
			// Rendered last: its listeners reference those elements.
			@components.HTMXScript()
		</body>
	</html>
}

// authHelperScript exposes cookie + auth-header helpers used by every page's
// inline fetch() calls. Defined early so handlers in <body> can call them.
templ authHelperScript() {
	<script>
		function getCookie(name) {
			const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
			return match ? decodeURIComponent(match[2]) : null;
		}
		function setCookie(name, value, days) {
			const d = new Date();
			d.setTime(d.getTime() + (days * 24 * 60 * 60 * 1000));
			document.cookie = name + '=' + encodeURIComponent(value) + ';expires=' + d.toUTCString() + ';path=/';
		}
		function deleteCookie(name) {
			document.cookie = name + '=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/';
		}
		function getAuthHeaders() {
			const token = getCookie('nano-kvm-token') || '';
			return { 'Content-Type': 'application/json', 'token': token };
		}
		function encryptPassword(password) {
			const SECRET_KEY = 'nanokvm-sipeed-2024';
			const encrypted = CryptoJS.AES.encrypt(password, SECRET_KEY).toString();
			return encodeURIComponent(encrypted);
		}
		async function apiGet(url) {
			return (await fetch(url, { headers: getAuthHeaders() })).json();
		}
		async function apiPost(url, body) {
			return (await fetch(url, {
				method: 'POST',
				headers: getAuthHeaders(),
				body: body ? JSON.stringify(body) : undefined,
			})).json();
		}
	</script>
}
