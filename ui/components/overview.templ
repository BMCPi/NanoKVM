package components

import (
	"github.com/pi-bmc/nanokvm-app/pkg/application"
	"github.com/pi-bmc/nanokvm-app/pkg/config"
	"github.com/pi-bmc/nanokvm-app/pkg/deps"
	"github.com/pi-bmc/nanokvm-app/pkg/sysinfo"
	"github.com/pi-bmc/nanokvm-app/ui/components/badge"
	"github.com/pi-bmc/nanokvm-app/ui/components/button"
	"github.com/pi-bmc/nanokvm-app/ui/components/card"
	"github.com/pi-bmc/nanokvm-app/ui/components/icon"
	selectcomp "github.com/pi-bmc/nanokvm-app/ui/components/select"
	"github.com/pi-bmc/nanokvm-app/ui/components/spinner"
)

// overviewSidebarID is the ID of the slide-in panel.
const overviewSidebarID = "overview-sidebar"

// OverviewSidebar is a push-style sidebar contained within the dashboard's
// flex row (next to the console pane, below the navbar). Width animates
// from 0 (closed) to 24rem (open) via data-state, so opening it shrinks
// the console pane rather than overlaying it.
//
// We do NOT use the shadcn-templ Sidebar component here: that one positions
// its <aside> as `fixed inset-y-0 h-svh`, so it always covers the navbar.
//
// Every dynamic region is an htmx fragment (routes in ui/fragments_overview.go):
// cheap local values render with the page, everything else loads with
// hx-trigger="load" and re-renders on the fw-changed event that mutating
// fragment handlers raise via HX-Trigger.
templ OverviewSidebar() {
	@overviewSidebarStyles()
	<aside
		id={ overviewSidebarID }
		class="ov-sidebar"
		data-state="closed"
		aria-label="Server Overview"
	>
		<div class="ov-sidebar-inner">
			<div class="flex items-center justify-between border-b border-border px-4 py-3">
				<div>
					<h2 class="text-sm font-semibold">Server Overview</h2>
					<p class="text-xs text-muted-foreground">Identity, network, and firmware state.</p>
				</div>
				@button.Button(button.Props{
					Variant: button.VariantGhost,
					Size:    button.SizeIcon,
					Attributes: templ.Attributes{
						"onclick":    "toggleOverview()",
						"title":      "Close",
						"aria-label": "Close Server Overview",
					},
				}) {
					@icon.X()
				}
			</div>
			<div class="flex-1 min-h-0 overflow-y-auto no-scrollbar px-4 py-3 space-y-4">
				@overviewServerCard()
				@overviewBmcCard()
				@overviewBiosCard()
				@overviewBootOverrideCard()
				@overviewKernelCard()
			</div>
		</div>
	</aside>
	@overviewToggleScript()
}

templ overviewSidebarStyles() {
	<style>
		.ov-sidebar {
			width: 0;
			flex-shrink: 0;
			overflow: hidden;
			border-left: 1px solid var(--border);
			background: var(--card);
			display: flex;
			flex-direction: column;
			transition: width 0.2s ease;
		}
		.ov-sidebar[data-state="open"] { width: 24rem; }
		@media (max-width: 640px) {
			.ov-sidebar[data-state="open"] { width: 100%; }
		}
		/* Inner wrapper keeps content at a stable width during the width
		   animation so nothing reflows mid-transition. */
		.ov-sidebar-inner {
			width: 24rem;
			max-width: 100vw;
			height: 100%;
			display: flex;
			flex-direction: column;
		}
		.ov-row { display: flex; align-items: center; justify-content: space-between; gap: .5rem; padding: .375rem 0; border-bottom: 1px solid var(--border); }
		.ov-row:last-child { border-bottom: none; }
		.ov-label { font-size: .75rem; color: var(--muted-foreground); flex-shrink: 0; }
		.ov-value { font-size: .75rem; font-family: var(--font-mono); text-align: right; word-break: break-all; min-width: 0; }
	</style>
}

// overviewServerCard is the server identity card. The body is a fragment:
// the inventory merge reads SMBIOS + the U-Boot env, so it loads after
// first paint exactly like the old fetch did.
templ overviewServerCard() {
	@card.Card() {
		@card.Header() {
			@card.Title(card.TitleProps{Class: "text-sm"}) {
				Server Information
			}
			@card.Description(card.DescriptionProps{Class: "text-xs"}) {
				Hardware identity of the managed server.
			}
		}
		// display:contents keeps Content/Footer direct flex children of the
		// Card for its gap spacing; the div only carries the htmx wiring.
		<div class="contents" hx-get="/ui/overview/server" hx-trigger="load, fw-changed from:body">
			@OverviewServerBody(OverviewServer{})
		</div>
	}
}

// OverviewServerBody renders the identity rows; the zero model renders
// placeholders for first paint.
templ OverviewServerBody(m OverviewServer) {
	@card.Content(card.ContentProps{Class: "py-0 pb-2"}) {
		@ovRow("Board", m.Board)
		@ovRow("Vendor", m.Vendor)
		@ovRow("CPU / SoC", m.CPU)
		@ovRow("Memory", m.Memory)
		@ovRow("Serial", m.Serial)
		@ovRow("Revision", m.Revision)
		@ovRow("Board MAC", m.MAC)
	}
	// The service merges SMBIOS over the U-Boot env and reports which won
	// in Oem.NanoKVM.InventorySource, so the footer names the actual source.
	@card.Footer(card.FooterProps{Class: "pt-2 text-[0.6875rem] text-muted-foreground"}) {
		// templ trims text nodes, so spacing around the injected span and
		// the link comes from margin utilities.
		Read from
		if m.InventorySource != "" {
			<span class="mx-1">{ m.InventorySource }</span>
		} else {
			<span class="mx-1">the managed server</span>
		}
		via
		<a href="/redfish/v1/Systems/1" target="_blank" rel="noopener noreferrer" class="ml-1 underline underline-offset-4 hover:text-foreground">Redfish</a>.
	}
}

// overviewBmcCard is the BMC build + network identity card — all local
// values, rendered with the page. Only the release check (a GitHub call)
// is a fragment.
templ overviewBmcCard() {
	@card.Card() {
		@card.Header() {
			@card.Title(card.TitleProps{Class: "text-sm"}) {
				BMC Information
			}
			@card.Description(card.DescriptionProps{Class: "text-xs"}) {
				Current BMC build + management interface.
			}
		}
		@card.Content(card.ContentProps{Class: "py-0 pb-2"}) {
			<div class="ov-row">
				<span class="ov-label">Application</span>
				<span class="ov-value flex items-center gap-1.5 justify-end">
					<span>
						if v := versionDisplay(application.CurrentVersion()); v != "" {
							{ v }
						} else {
							—
						}
					</span>
					<span class="contents" hx-get="/ui/overview/app-update" hx-trigger="load"></span>
				</span>
			</div>
			@ovRow("Image", sysinfo.ImageVersion())
			@ovRow("Hardware", config.GetInstance().Hardware.Version.String())
			@ovRow("IP Address", sysinfo.PrimaryIP())
		}
		@card.Footer(card.FooterProps{Class: "pt-2 text-xs text-muted-foreground"}) {
			Interfaces: IPMI :623 · <a href="/redfish/v1" target="_blank" rel="noopener noreferrer" class="ml-1 underline underline-offset-4 hover:text-foreground">Redfish</a>
		}
	}
}

// OverviewAppUpdateBody is the release-check chunk beside the Application
// row: an update action when one is available, a Latest badge when current,
// nothing when the check could not reach upstream (closed networks).
templ OverviewAppUpdateBody(m OverviewUpdateCheck) {
	if m.Checked && m.UpdateAvailable {
		@button.Button(button.Props{
			Variant: button.VariantOutline,
			Size:    button.SizeSm,
			Class:   "h-6 px-2 text-xs",
			Attributes: templ.Attributes{
				"hx-post":                  "/ui/overview/app/update",
				"hx-swap":                  "none",
				"hx-disabled-elt":          "this",
				"hx-confirm":               "Downloads and installs the latest release. The service restarts when it finishes.",
				"data-confirm-title":       "Update the application?",
				"data-confirm-label":       "Update",
				// The service restarts after a successful update; reload once
				// it has had time to come back.
				"hx-on::after-request": "if(event.detail.successful) setTimeout(() => location.reload(), 6000)",
			},
		}) {
			Update → { versionDisplay(m.Latest) }
		}
	} else if m.Checked && m.Current != "" {
		@badge.Badge(badge.Props{
			Variant: badge.VariantSecondary,
			Class:   "bg-green-500/15 text-green-500",
		}) {
			Latest
		}
	}
}

// overviewBiosCard shows U-Boot identity + firmware state. First paint
// carries the cheap firmware-cache status; the fragment fills in the boot
// rows and the release check.
templ overviewBiosCard() {
	@card.Card() {
		@card.Header() {
			@card.Title(card.TitleProps{Class: "text-sm"}) {
				BIOS Information
			}
			@card.Description(card.DescriptionProps{Class: "text-xs"}) {
				U-Boot identity and boot-method discovery.
			}
		}
		<div class="contents" hx-get="/ui/overview/bios" hx-trigger="load, fw-changed from:body">
			@OverviewBiosBody(OverviewBiosFirstPaint(deps.FromContext(ctx).Firmware))
		</div>
	}
}

// OverviewBiosBody renders the BIOS card content + footer from the model.
templ OverviewBiosBody(m OverviewBios) {
	@card.Content(card.ContentProps{Class: "py-0 pb-2"}) {
		@ovRow("Firmware", m.FirmwareStatus)
		<div class="ov-row">
			<span class="ov-label">U-Boot</span>
			<span class="ov-value flex items-center gap-1.5 justify-end">
				<span>
					if v := versionDisplay(m.UBoot.Current); v != "" {
						{ v }
					} else {
						—
					}
				</span>
				if m.UBoot.Checked && m.UBoot.UpdateAvailable {
					@button.Button(button.Props{
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
						Class:   "h-6 px-2 text-xs",
						Attributes: templ.Attributes{
							"hx-post":            "/ui/overview/bios/update",
							"hx-target":          "#ov-fw-progress",
							"hx-swap":            "innerHTML",
							"hx-disabled-elt":    "this",
							"hx-confirm":         "Downloads the latest U-Boot image. Env files (machine.env, persistent.env, once.env) are preserved.",
							"data-confirm-title": "Update the BIOS (U-Boot)?",
							"data-confirm-label": "Update",
						},
					}) {
						Update → { versionDisplay(m.UBoot.Latest) }
					}
				} else if m.UBoot.Checked && m.UBoot.Current != "" {
					@badge.Badge(badge.Props{
						Variant: badge.VariantSecondary,
						Class:   "bg-green-500/15 text-green-500",
					}) {
						Latest
					}
				}
			</span>
		</div>
		@ovRow("Device Tree", m.DeviceTree)
		@ovRow("Boot Targets", m.BootTargets)
		@ovRow("Boot Override", m.BootOverride)
		@ovRow("Boot Methods", m.BootMethods)
	}
	@card.Footer(card.FooterProps{Class: "pt-2 flex flex-col gap-2 w-full"}) {
		if m.DownloadNeeded {
			<div class="w-full flex items-center justify-between">
				<span class="text-xs text-muted-foreground">Firmware image not cached</span>
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Attributes: templ.Attributes{
						"hx-post":         "/ui/overview/fw/download",
						"hx-target":       "#ov-fw-progress",
						"hx-swap":         "innerHTML",
						"hx-disabled-elt": "this",
					},
				}) {
					Download
				}
			</div>
		}
		<div id="ov-fw-progress">
			if m.Downloading {
				@OvFwPoller()
			}
		</div>
		<div class="flex items-center justify-between w-full">
			<span class="text-xs text-muted-foreground">RPi 5 bootloader EEPROM</span>
			@EEPROMDialogTrigger()
		</div>
	}
}

// OvFwPoller polls the shared firmware download flag every few seconds and
// swaps itself out at the terminal state (the progress handler answers with
// nothing and raises the toast + fw-changed refresh).
templ OvFwPoller() {
	<div
		class="flex items-center gap-2 text-xs text-muted-foreground"
		hx-get="/ui/overview/fw/progress"
		hx-trigger="every 3s"
		hx-swap="outerHTML"
	>
		@spinner.Spinner(spinner.Props{Class: "size-3.5"})
		Downloading image…
	</div>
}

// overviewBootOverrideCard wraps the Redfish boot override controls: one
// form, submitted by whichever mode button is clicked.
templ overviewBootOverrideCard() {
	@card.Card() {
		@card.Header() {
			@card.Title(card.TitleProps{Class: "text-sm"}) {
				Boot Override
			}
			@card.Description(card.DescriptionProps{Class: "text-xs"}) {
				Override the next boot source via Redfish.
			}
		}
		<form class="contents" hx-post="/ui/overview/boot-override" hx-swap="none">
			@card.Content(card.ContentProps{Class: "py-2"}) {
				@bootOverrideSelect()
			}
			@card.Footer(card.FooterProps{Class: "pt-2 flex items-center gap-2 flex-wrap"}) {
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Size:       button.SizeSm,
					Type:       button.TypeSubmit,
					Attributes: templ.Attributes{"name": "mode", "value": "once"},
				}) {
					Once
				}
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Size:       button.SizeSm,
					Type:       button.TypeSubmit,
					Attributes: templ.Attributes{"name": "mode", "value": "continuous"},
				}) {
					Persistent
				}
			}
		</form>
	}
}

// bootOverrideSelect backs the Boot Override form; the hidden input carries
// name=boot-override. The explicit ID keeps the portaled popup's
// aria-controls stable across fragment re-renders.
templ bootOverrideSelect() {
	@selectcomp.Select(selectcomp.Props{ID: "boot-override-select", Name: "boot-override", Value: "None"}) {
		@selectcomp.Trigger(selectcomp.TriggerProps{Class: "w-full"}) {
			@selectcomp.Value(selectcomp.ValueProps{Placeholder: "None (default)"})
		}
		@selectcomp.Content() {
			// Select Props.Value "None" already marks this item selected.
			@selectcomp.Item(selectcomp.ItemProps{Value: "None"}) {
				None (default)
			}
			@selectcomp.Item(selectcomp.ItemProps{Value: "Pxe"}) {
				PXE (network)
			}
			@selectcomp.Item(selectcomp.ItemProps{Value: "Hdd"}) {
				HDD / MMC / NVMe
			}
			@selectcomp.Item(selectcomp.ItemProps{Value: "Cd"}) {
				CD / USB
			}
			@selectcomp.Item(selectcomp.ItemProps{Value: "BiosSetup"}) {
				BIOS Setup
			}
			@selectcomp.Item(selectcomp.ItemProps{Value: "UefiHttp"}) {
				UEFI HTTP Boot
			}
		}
	}
}

// overviewKernelCard wraps the kernel-version selector + per-kernel actions.
// Selection is server state: the select's change bubbles to the wrapper,
// which re-fetches the body with ?kernel=… and renders that row's actions.
templ overviewKernelCard() {
	@card.Card() {
		@card.Header() {
			@card.Title(card.TitleProps{Class: "text-sm"}) {
				Kernel Version
			}
			@card.Description(card.DescriptionProps{Class: "text-xs"}) {
				Cached U-Boot images by supported Linux kernel version.
			}
		}
		<div
			class="contents"
			hx-get="/ui/overview/kernels"
			hx-trigger="change, fw-changed from:body"
			hx-include="find input[name='kernel']"
		>
			@OverviewKernelsBody(OverviewKernelsFirstPaint(deps.FromContext(ctx).Firmware))
		</div>
	}
}

// OverviewKernelsBody renders the selector plus the selected kernel's
// actions. The explicit select ID keeps the portaled popup bound across
// re-renders (see bootOverrideSelect).
templ OverviewKernelsBody(m OverviewKernels) {
	@card.Content(card.ContentProps{Class: "py-2 space-y-1.5"}) {
		@selectcomp.Select(selectcomp.Props{ID: "kernel-select", Name: "kernel", Value: m.Selected}) {
			@selectcomp.Trigger(selectcomp.TriggerProps{Class: "w-full"}) {
				@selectcomp.Value(selectcomp.ValueProps{Placeholder: "Select kernel version…"})
			}
			@selectcomp.Content() {
				for _, k := range m.Kernels {
					@selectcomp.Item(selectcomp.ItemProps{Value: k.Kernel}) {
						Linux { k.Kernel } → U-Boot { k.UBoot }
						if k.Active {
							<span class="text-muted-foreground">★ Active</span>
						} else if k.Downloaded {
							<span class="text-muted-foreground">(Downloaded)</span>
						}
					}
				}
			}
		}
		if sel, ok := m.SelectedKernel(); ok && sel.Active {
			<div class="text-[0.6875rem] text-muted-foreground">★ Active</div>
		}
	}
	@card.Footer(card.FooterProps{Class: "pt-2 flex flex-col gap-2 w-full"}) {
		if sel, ok := m.SelectedKernel(); ok {
			<div class="flex flex-wrap items-center gap-1.5">
				if !sel.Downloaded {
					@button.Button(button.Props{
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
						Attributes: templ.Attributes{
							"hx-post":         "/ui/overview/kernel/download",
							"hx-include":      "input[name='kernel']",
							"hx-target":       "#kernel-progress",
							"hx-swap":         "innerHTML",
							"hx-disabled-elt": "this",
						},
					}) {
						Download
					}
				} else {
					@button.Button(button.Props{
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
						Attributes: templ.Attributes{
							"hx-post":            "/ui/overview/kernel/download",
							"hx-vals":            `{"force": "true"}`,
							"hx-include":         "input[name='kernel']",
							"hx-target":          "#kernel-progress",
							"hx-swap":            "innerHTML",
							"hx-disabled-elt":    "this",
							"hx-confirm":         "The existing cached image will be overwritten. If it is the active image, it is replaced in place (env files preserved).",
							"data-confirm-title": "Re-download U-Boot for Linux " + sel.Kernel + "?",
							"data-confirm-label": "Re-download",
							"title":              "Re-download to overwrite existing cached image",
						},
					}) {
						Refresh
					}
					if !sel.Active {
						@button.Button(button.Props{
							Size: button.SizeSm,
							Attributes: templ.Attributes{
								"hx-post":            "/ui/overview/kernel/activate",
								"hx-include":         "input[name='kernel']",
								"hx-swap":            "none",
								"hx-disabled-elt":    "this",
								"hx-confirm":         "Env files (machine.env, persistent.env, once.env) are preserved.",
								"data-confirm-title": "Activate U-Boot for Linux " + sel.Kernel + "?",
								"data-confirm-label": "Activate",
							},
						}) {
							Activate
						}
					}
				}
			</div>
		}
		<div id="kernel-progress">
			if m.Downloading {
				@OvFwPoller()
			}
		</div>
	}
}

// ovRow renders one label / value row; the em-dash placeholder shows while
// a fragment has not yet supplied the value.
templ ovRow(label, value string) {
	<div class="ov-row">
		<span class="ov-label">{ label }</span>
		<span class="ov-value">
			if value != "" {
				{ value }
			} else {
				—
			}
		</span>
	</div>
}

// overviewToggleScript exposes openOverview / closeOverview / toggleOverview
// globally. The navbar button calls toggleOverview(); ESC closes. Pure
// open/close UI state — deliberately not htmx.
templ overviewToggleScript() {
	<script>
		(function() {
			const el = () => document.getElementById('overview-sidebar');
			const setState = (s) => { const a = el(); if (a) a.dataset.state = s; };
			window.openOverview  = () => setState('open');
			window.closeOverview = () => setState('closed');
			window.toggleOverview = () => {
				const a = el();
				if (!a) return;
				a.dataset.state = a.dataset.state === 'open' ? 'closed' : 'open';
			};
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') {
					const a = el();
					if (a && a.dataset.state === 'open') closeOverview();
				}
			});
		})();
	</script>
}
