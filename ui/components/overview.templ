package components

import (
	"log/slog"

	"github.com/pi-bmc/nanokvm-app/pkg/app/application"
	"github.com/pi-bmc/nanokvm-app/pkg/config"
	"github.com/pi-bmc/nanokvm-app/pkg/platform/sysinfo"
	"github.com/pi-bmc/nanokvm-app/pkg/platform/telemetry"
	"github.com/pi-bmc/nanokvm-app/ui/components/badge"
	"github.com/pi-bmc/nanokvm-app/ui/components/button"
	"github.com/pi-bmc/nanokvm-app/ui/components/card"
	"github.com/pi-bmc/nanokvm-app/ui/components/icon"
	"github.com/pi-bmc/nanokvm-app/ui/components/item"
)

// overviewSidebarID is the ID of the slide-in panel.
const overviewSidebarID = "overview-sidebar"

// overviewCardClass retunes card.Card for a drawer.
//
// The component's own scale is built for a page: 32px of padding and 32px
// between header, content and footer. In a 28rem panel that spends a quarter
// of the width on gutters and pushes a four-row readout to the height of a
// screenful. Sixteen inside a card, sixteen between cards (the list's
// space-y-4) and eight between a card's own parts is one scale with one
// ratio, and it buys back 32px of line length per row.
const overviewCardClass = "gap-2 [--card-spacing:--spacing(4)]"

// OverviewSidebar is a push-style sidebar contained within the dashboard's
// flex row (next to the console pane, below the navbar). Width animates
// from 0 (closed) to 24rem (open) via data-state, so opening it shrinks
// the console pane rather than overlaying it.
//
// We do NOT use the shadcn-templ Sidebar component here: that one positions
// its <aside> as `fixed inset-y-0 h-svh`, so it always covers the navbar.
//
// Every dynamic region is an htmx fragment (routes in ui/fragments_overview.go):
// cheap local values render with the page, everything else loads with
// hx-trigger="load" and re-renders on the fw-changed event that mutating
// fragment handlers raise via HX-Trigger.
templ OverviewSidebar(log *slog.Logger) {
	@overviewSidebarStyles()
	<aside
		id={ overviewSidebarID }
		class="ov-sidebar"
		data-state="closed"
		aria-label="Server Overview"
	>
		<div class="ov-sidebar-inner">
			@item.Item(item.Props{Class: "rounded-none border-0 border-b border-border px-4 py-4"}) {
				@item.Content(item.ContentProps{Class: "gap-0"}) {
					@item.Title(item.TitleProps{Class: "font-semibold"}) {
						Server Overview
					}
					@item.Description(item.DescriptionProps{Class: "text-xs"}) {
						Identity, network, and firmware state.
					}
				}
				@item.Actions() {
					@button.Button(button.Props{
						Variant: button.VariantGhost,
						Size:    button.SizeIcon,
						Attributes: templ.Attributes{
							"onclick":    "toggleOverview()",
							"title":      "Close",
							"aria-label": "Close Server Overview",
						},
					}) {
						@icon.X()
					}
				}
			}
			<div class="flex-1 min-h-0 overflow-y-auto no-scrollbar px-4 py-3 space-y-4">
				// Activity and Resources lead: they are the only cards whose
				// numbers move, so they answer "what is happening right now"
				// before the identity cards answer "what is this". Both are
				// lazy — see overviewActivityCard for why the drawer's live
				// cards wait for the open event.
				@overviewActivityCard()
				@overviewResourcesCard()
				@overviewHostSensorsCard()
				@overviewServerCard()
				@overviewBmcCard(log)
				@overviewHostFirmwareCard()
			</div>
		</div>
	</aside>
	@overviewToggleScript()
}

templ overviewSidebarStyles() {
	<style>
		/* The width belongs to the resizable panel this sits in (see
		   home.templ), not to the sidebar: it used to animate its own width
		   between 0 and 24rem, which would now fight the drag handle. What is
		   left here is the surface — fill the panel, draw the edge, stack the
		   cards. */
		/* --background, not --card: the cards inside are --card, and a card on
		   a surface of its own colour is a card you cannot see. Putting the
		   drawer on the darker ground gives the five cards an edge without
		   drawing one, which is the whole reason they are cards. */
		.ov-sidebar {
			width: 100%;
			height: 100%;
			overflow: hidden;
			border-left: 1px solid var(--border);
			background: var(--background);
			display: flex;
			flex-direction: column;
		}
		/* Collapsed the panel is zero-width, and a 1px border on a zero-width
		   box still paints as a stray rule down the edge of the console. */
		.ov-sidebar[data-state="closed"] { border-left-width: 0; }
		/* min-width:0 lets the cards inside reflow as the panel narrows
		   instead of forcing a horizontal scrollbar. */
		.ov-sidebar-inner {
			width: 100%;
			min-width: 0;
			height: 100%;
			display: flex;
			flex-direction: column;
		}
	</style>
}

// overviewActivityCard is what the BMC has been doing, beside what it is.
//
// Unlike its siblings this one does NOT load on page load. The other cards read
// cheap local state that is also stable, so fetching it once with the page is
// free; this one gathers the whole Prometheus registry and its numbers move
// constantly, so loading it with the page would both cost the SoC's single core
// work for a drawer nobody has opened and show figures that were true when the
// tab was opened an hour ago. Binding to the open event instead makes it lazy
// and current at the same time — every open re-reads.
templ overviewActivityCard() {
	@card.Card(card.Props{Class: overviewCardClass}) {
		@card.Header(card.HeaderProps{Class: "gap-1"}) {
			@card.Title(card.TitleProps{Class: SectionLabelClass}) {
				Activity
			}
			@card.Description(card.DescriptionProps{Class: "text-xs"}) {
				Sessions and traffic since boot.
			}
		}
		<div class="contents" hx-get="/ui/overview/activity" hx-trigger="overview-opened from:body">
			@MetricsOverviewBody(telemetry.Snapshot{}, nil)
		</div>
	}
}

// overviewServerCard is the server identity card. The body is a fragment:
// the inventory merge reads what the host last reported over Redfish, so it
// loads after first paint exactly like the old fetch did.
templ overviewServerCard() {
	@card.Card(card.Props{Class: overviewCardClass}) {
		@card.Header(card.HeaderProps{Class: "gap-1"}) {
			@card.Title(card.TitleProps{Class: SectionLabelClass}) {
				Server Information
			}
			@card.Description(card.DescriptionProps{Class: "text-xs"}) {
				Hardware identity of the managed server.
			}
		}
		// display:contents keeps Content/Footer direct flex children of the
		// Card for its gap spacing; the div only carries the htmx wiring.
		<div class="contents" hx-get="/ui/overview/server" hx-trigger="load, fw-changed from:body">
			@OverviewServerBody(OverviewServer{})
		</div>
	}
}

// OverviewServerBody renders the identity rows; the zero model renders
// placeholders for first paint.
templ OverviewServerBody(m OverviewServer) {
	@card.Content() {
		// has-data-[size=xs]:gap-0 counters the Group's own xs gap — the
		// rows' hairline borders are the separation here.
		@item.Group(item.GroupProps{Class: "has-data-[size=xs]:gap-0"}) {
			@statusRow("Board", m.Board)
			@statusRow("Vendor", m.Vendor)
			@statusRow("CPU / SoC", m.CPU)
			@statusRow("Memory", m.Memory)
			@statusRow("Serial", m.Serial)
			@statusRow("Revision", m.Revision)
		}
	}
	// The service reports the winning inventory source in
	// Oem.NanoKVM.InventorySource, so the footer names the actual source.
	@card.Footer(card.FooterProps{Class: "text-xs text-muted-foreground"}) {
		// templ trims text nodes, so spacing around the injected span and
		// the link comes from margin utilities.
		Read from
		if m.InventorySource != "" {
			<span class="mx-1">{ m.InventorySource }</span>
		} else {
			<span class="mx-1">the managed server</span>
		}
		via
		<a href="/redfish/v1/Systems/1" target="_blank" rel="noopener noreferrer" class="ml-1 underline underline-offset-4 hover:text-foreground">Redfish</a>.
	}
}

// overviewBmcCard is the BMC build + network identity card — all local
// values, rendered with the page. Only the release check (a GitHub call)
// is a fragment.
templ overviewBmcCard(log *slog.Logger) {
	@card.Card(card.Props{Class: overviewCardClass}) {
		@card.Header(card.HeaderProps{Class: "gap-1"}) {
			@card.Title(card.TitleProps{Class: SectionLabelClass}) {
				BMC Information
			}
			@card.Description(card.DescriptionProps{Class: "text-xs"}) {
				Current BMC build + management interface.
			}
		}
		@card.Content() {
			@item.Group(item.GroupProps{Class: "has-data-[size=xs]:gap-0"}) {
				// statusRow with a trailing slot: the release check loads into
				// the value cluster, so the Content is laid out as a row
				// instead of the helper's single value cell.
				@item.Item(item.Props{Size: item.SizeXs, Class: statusRowClasses}) {
					@item.Title(item.TitleProps{Class: "shrink-0 font-normal text-muted-foreground"}) {
						Application
					}
					@item.Content(item.ContentProps{Class: "flex flex-row items-baseline gap-2"}) {
						@statusValue(versionDisplay(application.CurrentVersion()))
						<span class="contents" hx-get="/ui/overview/app-update" hx-trigger="load"></span>
					}
				}
				@statusRow("Image", sysinfo.ImageVersion())
				@statusRow("Hardware", config.GetInstance().Hardware.Version.String())
				@statusRow("IP Address", sysinfo.PrimaryIP(log))
			}
		}
		@card.Footer(card.FooterProps{Class: "text-xs text-muted-foreground"}) {
			Interfaces: IPMI :623 · <a href="/redfish/v1" target="_blank" rel="noopener noreferrer" class="ml-1 underline underline-offset-4 hover:text-foreground">Redfish</a>
		}
	}
}

// OverviewAppUpdateBody is the release-check chunk beside the Application
// row: an update action when one is available, a Latest badge when current,
// nothing when the check could not reach upstream (closed networks).
templ OverviewAppUpdateBody(m OverviewUpdateCheck) {
	if m.Checked && m.UpdateAvailable {
		@button.Button(button.Props{
			Variant: button.VariantOutline,
			Size:    button.SizeSm,
			Attributes: templ.Attributes{
				"hx-post":                  "/ui/overview/app/update",
				"hx-swap":                  "none",
				"hx-disabled-elt":          "this",
				"hx-confirm":               "Downloads and installs the latest release. The service restarts when it finishes.",
				"data-confirm-title":       "Update the application?",
				"data-confirm-label":       "Update",
				// The service restarts after a successful update; reload once
				// it has had time to come back.
				"hx-on::after-request": "if(event.detail.successful) setTimeout(() => location.reload(), 6000)",
			},
		}) {
			Update → { versionDisplay(m.Latest) }
		}
	} else if m.Checked && m.Current != "" {
		@badge.Badge(badge.Props{
			Variant: badge.VariantSecondary,
			Class:   "bg-green-500/15 text-green-500 text-xs",
		}) {
			Latest
		}
	}
}

// overviewHostFirmwareCard shows what the host firmware last reported over
// the Redfish host interface, plus the boot override currently staged for
// it. Pure display — an override is staged from the navbar's power menu
// (PowerBootOverride in power_menu.templ), the only control for it.
templ overviewHostFirmwareCard() {
	@card.Card(card.Props{Class: overviewCardClass}) {
		@card.Header(card.HeaderProps{Class: "gap-1"}) {
			@card.Title(card.TitleProps{Class: SectionLabelClass}) {
				Host Firmware
			}
			@card.Description(card.DescriptionProps{Class: "text-xs"}) {
				Firmware state reported by the managed host.
			}
		}
		<div class="contents" hx-get="/ui/overview/firmware" hx-trigger="load, fw-changed from:body">
			@OverviewHostFirmwareBody(OverviewHostFirmware{})
		</div>
	}
}

// OverviewHostFirmwareBody renders the host-firmware rows from the model.
// Boot Progress is host-reported and only present once the host firmware has
// checked in over the host interface, so the row is omitted while empty
// rather than showing a placeholder that suggests missing data.
templ OverviewHostFirmwareBody(m OverviewHostFirmware) {
	@card.Content() {
		@item.Group(item.GroupProps{Class: "has-data-[size=xs]:gap-0"}) {
			@statusRow("BIOS Version", m.BiosVersion)
			@statusRow("Boot Override", m.BootOverride)
			if m.BootProgress != "" {
				@statusRow("Boot Progress", m.BootProgress)
			}
		}
	}
	@card.Footer(card.FooterProps{Class: "text-xs text-muted-foreground"}) {
		Reported by the host firmware via
		<a href="/redfish/v1/Systems/1" target="_blank" rel="noopener noreferrer" class="ml-1 underline underline-offset-4 hover:text-foreground">Redfish</a>.
	}
}

// overviewToggleScript exposes openOverview / closeOverview / toggleOverview
// globally. The navbar button calls toggleOverview(); ESC closes. Pure
// open/close UI state — deliberately not htmx.
//
// The width now belongs to a resizable panel (home.templ), so open and close
// are collapse and expand on that panel rather than a class flip. data-state
// on the <aside> stays the thing everything else reads — the Activity card's
// hx-trigger fires on the open event, and the border rule keys off it — so it
// is kept in step with the panel from both directions: these functions push
// it, and the drag handle pushes it back through resizable-layout-changed.
templ overviewToggleScript() {
	<script>
		(function() {
			const aside = () => document.getElementById('overview-sidebar');
			const panel = () => document.getElementById('overview-panel');
			const api = () => window.tui && window.tui.resizable;

			// Every state change goes through here so the open event fires
			// however the drawer was opened — navbar button, toggle, a direct
			// openOverview() call, or a drag of the handle.
			const setState = (s) => {
				const a = aside();
				if (!a || a.dataset.state === s) return;
				a.dataset.state = s;
				if (s === 'open') {
					document.body.dispatchEvent(new CustomEvent('overview-opened'));
				}
			};

			// What the drawer opens to when nothing has been remembered yet.
			// The vendored panel expands to `panel.expandToSize ?? minSize`,
			// so without this the very first open lands on MinSize — and
			// MinSize is a floor for dragging, not a good reading width. The
			// drawer's content is label/value rows and charts, both of which
			// want more room than 20rem, so the first open gets its own
			// width and MinSize goes back to meaning only "no narrower than".
			const preferredOpenWidth = '28rem';

			// The panel remembers a width across collapse only when it was
			// collapsed through its own API. Dragging the handle shut stores
			// the previous size somewhere expand() does not read, so it
			// reopens at MinSize and the width an operator just chose is
			// lost. Keeping it here covers both routes without patching the
			// vendored component.
			let lastOpenPx = 0;

			const collapsed = () => {
				const r = api(), p = panel();
				// With no panel to ask, fall back to what the markup says:
				// the drawer is closed until something opens it.
				if (!r || !p) return aside()?.dataset.state !== 'open';
				return r.isCollapsed(p);
			};

			window.openOverview = () => {
				const r = api(), p = panel();
				if (r && p && r.isCollapsed(p)) {
					// Read the remembered width first: expand() emits a
					// layout change synchronously, and the listener below
					// would overwrite it with the width expand just landed on
					// before this line got to use it.
					const want = lastOpenPx > 0 ? lastOpenPx + 'px' : preferredOpenWidth;
					r.expand(p);
					// resize() clamps to the group's constraints, so a window
					// too narrow for 28rem lands on whatever fits instead of
					// squeezing the console past its own MinSize.
					r.resize(p, want);
				}
				setState('open');
			};
			window.closeOverview = () => {
				const r = api(), p = panel();
				if (r && p && !r.isCollapsed(p)) r.collapse(p);
				setState('closed');
			};
			window.toggleOverview = () => {
				collapsed() ? openOverview() : closeOverview();
			};
			// Read by the live cards' hx-trigger poll filters, so a closed
			// drawer issues no requests.
			window.isOverviewOpen = () => !collapsed();

			// Dragging the handle all the way shut is a close, and dragging it
			// open is an open — including the first one, which has to fire the
			// event the Activity card waits for.
			document.addEventListener('resizable-layout-changed', () => {
				const r = api(), p = panel();
				const shut = collapsed();
				if (!shut && r && p) {
					const size = r.getSize(p);
					if (size && size.inPixels > 0) lastOpenPx = size.inPixels;
				}
				setState(shut ? 'closed' : 'open');
			});

			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && !collapsed()) closeOverview();
			});
		})();
	</script>
}
