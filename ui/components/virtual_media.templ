package components

import (
	"fmt"

	"github.com/pi-bmc/nanokvm-app/pkg/deps"
	"github.com/pi-bmc/nanokvm-app/pkg/firmware"
	"github.com/pi-bmc/nanokvm-app/ui/components/button"
	"github.com/pi-bmc/nanokvm-app/ui/components/dropdownmenu"
	"github.com/pi-bmc/nanokvm-app/ui/components/icon"
	"github.com/pi-bmc/nanokvm-app/ui/components/input"
	"github.com/pi-bmc/nanokvm-app/ui/components/item"
	"github.com/pi-bmc/nanokvm-app/ui/components/progress"
	selectcomp "github.com/pi-bmc/nanokvm-app/ui/components/select"
	"github.com/pi-bmc/nanokvm-app/ui/components/spinner"
	"github.com/pi-bmc/nanokvm-app/ui/components/tabs"
	"github.com/pi-bmc/nanokvm-app/ui/utils"
)

// formatBytes renders a byte count as a human-readable size — used by the
// fetch-progress view since remote Content-Lengths can be gigabytes.
func formatBytes(n int64) string {
	const unit = 1024
	if n < unit {
		return fmt.Sprintf("%d B", n)
	}
	div, exp := int64(unit), 0
	for v := n / unit; v >= unit; v /= unit {
		div *= unit
		exp++
	}
	return fmt.Sprintf("%.1f %cB", float64(n)/float64(div), "KMGTPE"[exp])
}

// MediaState snapshots the staged ISO list and insertion state; rendered
// with the page and by the /ui/media fragments after every mutation.
func MediaState(fw *firmware.Controller) (files []string, inserted string) {
	files, _ = fw.ListMediaFiles()
	return files, fw.GetVirtualMediaState().ImageName
}

// VirtualMediaMenu is the navbar virtual-media picker. Two server-rendered
// views — "current mount" (VMMenuBody) and "add media" (VMAddBody) — are
// swapped into #vm-menu-body by the /ui/media fragment routes; opening the
// menu re-fetches the current view so the state is always fresh.
templ VirtualMediaMenu() {
	{{ files, inserted := MediaState(deps.FromContext(ctx).Firmware) }}
	@dropdownmenu.DropdownMenu() {
		@button.Button(button.Props{
			Variant: button.VariantGhost,
			Size:    button.SizeSm,
			Attributes: utils.MergeAttributes(
				dropdownmenu.Trigger(ctx),
				templ.Attributes{
					"hx-get":     "/ui/media",
					"hx-target":  "#vm-menu-body",
					"hx-trigger": "click",
				},
			),
		}) {
			@icon.HardDrive()
			<span class="hidden sm:inline">Virtual Media</span>
			@icon.ChevronDown()
		}
		@dropdownmenu.Content(dropdownmenu.ContentProps{Class: "w-96 p-0 panel-fit"}) {
			<div id="vm-menu-body">
				@VMMenuBody(files, inserted)
			</div>
		}
	}
}

// VMMenuBody is the "current mount" view: mount state + entry to add view.
templ VMMenuBody(files []string, inserted string) {
	<div class="p-3 space-y-3">
		@item.Item(item.Props{Class: "p-0"}) {
			@item.Content() {
				@item.Title() {
					Virtual Media
				}
				@item.Description(item.DescriptionProps{Class: "text-xs"}) {
					Mount an image to boot from or install an OS.
				}
			}
			// data-tui-dropdownmenu-item is the component's close-on-click
			// contract: dropdownmenu.js closes the containing menu when a
			// carrier of it is clicked.
			// Default size IS h-7 — no Size + height override needed.
			@item.Actions() {
				@button.Button(button.Props{
					Variant:    button.VariantGhost,
					Attributes: templ.Attributes{"data-tui-dropdownmenu-item": true},
				}) {
					Close
				}
			}
		}
		@item.Item(item.Props{Variant: item.VariantOutline, Class: "rounded-md border-dashed"}) {
			@item.Media(item.MediaProps{Variant: item.MediaVariantIcon, Class: "size-8 rounded-full border border-border text-muted-foreground"}) {
				@icon.Disc()
			}
			@item.Content() {
				if inserted != "" {
					@item.Title(item.TitleProps{Class: "max-w-full text-green-500"}) {
						{ inserted }
					}
					@item.Description(item.DescriptionProps{Class: "text-xs"}) {
						Mounted as virtual media
					}
				} else {
					@item.Title() {
						No mounted media
					}
					@item.Description(item.DescriptionProps{Class: "text-xs"}) {
						Add a file to get started
					}
				}
			}
			if inserted != "" {
				@item.Actions() {
					@button.Button(button.Props{
						Variant: button.VariantDestructive,
						Attributes: templ.Attributes{
							"hx-post":         "/ui/media/eject",
							"hx-target":       "#vm-menu-body",
							"hx-disabled-elt": "this",
						},
					}) {
						Eject
					}
				}
			}
		}
		<div class="flex justify-end">
			@button.Button(button.Props{
				Size: button.SizeSm,
				Attributes: templ.Attributes{
					"hx-get":    "/ui/media/add",
					"hx-target": "#vm-menu-body",
				},
			}) {
				<span class="flex items-center gap-1">
					@icon.Plus()
					Add Media
				</span>
			}
		</div>
	</div>
}

// VMAddBody is the "add media" view: three tabs (Existing / Upload / URL)
// so height stays fixed. Mutations re-render this view (fresh file list);
// a successful mount answers with VMMenuBody instead.
templ VMAddBody(files []string) {
	<div class="p-3 space-y-3">
		@item.Item(item.Props{Class: "p-0"}) {
			@item.Content() {
				@item.Title() {
					Add New Media
				}
			}
			@item.Actions() {
				@button.Button(button.Props{
					Variant: button.VariantGhost,
					Attributes: templ.Attributes{
						"hx-get":    "/ui/media",
						"hx-target": "#vm-menu-body",
					},
				}) {
					<span class="flex items-center gap-1">
						@icon.ChevronLeft()
						Back
					</span>
				}
			}
		}
		@tabs.Tabs(tabs.Props{DefaultValue: "existing"}) {
			@tabs.List(tabs.ListProps{Class: "w-full"}) {
				@tabs.Trigger(tabs.TriggerProps{Value: "existing"}) {
					Existing
				}
				@tabs.Trigger(tabs.TriggerProps{Value: "upload"}) {
					Upload
				}
				@tabs.Trigger(tabs.TriggerProps{Value: "url"}) {
					URL
				}
			}
			@tabs.Content(tabs.ContentProps{Value: "existing", Class: "space-y-2"}) {
				<form
					class="flex items-center gap-2"
					hx-post="/ui/media/insert"
					hx-target="#vm-menu-body"
					hx-disabled-elt="find button"
				>
					@selectcomp.Select(selectcomp.Props{ID: "vm-insert-name", Name: "name"}) {
						@selectcomp.Trigger(selectcomp.TriggerProps{Class: "h-8 flex-1 min-w-0"}) {
							@selectcomp.Value(selectcomp.ValueProps{Placeholder: "— select ISO —"})
						}
						@selectcomp.Content() {
							for _, f := range files {
								@selectcomp.Item(selectcomp.ItemProps{Value: f}) {
									{ f }
								}
							}
						}
					}
					@button.Button(button.Props{Size: button.SizeSm, Type: button.TypeSubmit}) {
						Mount
					}
				</form>
			}
			@tabs.Content(tabs.ContentProps{Value: "upload", Class: "space-y-2"}) {
				<form
					id="vm-upload-form"
					class="flex items-center gap-2"
					hx-post="/ui/media/upload"
					hx-encoding="multipart/form-data"
					hx-target="#vm-menu-body"
					hx-disabled-elt="find button"
				>
					@input.Input(input.Props{
						ID:     "vm-upload-file",
						Name:   "file",
						Type:   "file",
						Accept: ".iso,.img",
						Class:  "flex-1 h-8",
					})
					@button.Button(button.Props{
						ID:       "vm-upload-submit",
						Size:     button.SizeSm,
						Type:     button.TypeSubmit,
						Disabled: true,
					}) {
						Upload
					}
				</form>
				// Hidden via the ATTRIBUTE, matching the rest of the app:
				// preflight's [hidden] { display:none !important } always wins,
				// where a `hidden` utility class competes with the component's
				// own display classes on stylesheet order.
				@progress.Progress(progress.Props{ID: "vm-upload-progress", Attributes: templ.Attributes{"hidden": true}})
			}
			@tabs.Content(tabs.ContentProps{Value: "url", Class: "space-y-2"}) {
				<form
					id="vm-fetch-form"
					class="space-y-2"
					hx-post="/ui/media/fetch"
					hx-target="#vm-menu-body"
					hx-disabled-elt="find button"
				>
					@input.Input(input.Props{
						ID:          "vm-fetch-url",
						Name:        "url",
						Type:        "url",
						Placeholder: "https://example.com/image.iso",
					})
					<div class="flex items-center gap-2">
						@input.Input(input.Props{
							ID:          "vm-fetch-name",
							Name:        "name",
							Placeholder: "filename.iso (optional)",
							Class:       "flex-1",
						})
						@button.Button(button.Props{
							ID:       "vm-fetch-submit",
							Size:     button.SizeSm,
							Type:     button.TypeSubmit,
							Disabled: true,
						}) {
							Fetch
						}
					</div>
				</form>
			}
		}
	</div>
}

// VMFetchProgress is swapped into #vm-menu-body while a URL fetch runs;
// GET /ui/media/fetch/progress polls it every second until the download
// reaches a terminal state (success renders VMMenuBody, failure re-renders
// VMAddBody with a toast).
templ VMFetchProgress(name string, loaded, total int64) {
	<div
		class="p-3 space-y-2"
		hx-get="/ui/media/fetch/progress"
		hx-trigger="every 1s"
		hx-swap="outerHTML"
	>
		<div class="text-sm font-semibold truncate">Fetching { name }…</div>
		if total > 0 {
			{{ pct := int(loaded * 100 / total) }}
			@progress.Progress(progress.Props{Value: pct, Max: 100})
			<div class="text-xs text-muted-foreground">{ formatBytes(loaded) } / { formatBytes(total) }</div>
		} else {
			<div class="flex items-center gap-2 text-xs text-muted-foreground">
				@spinner.Spinner(spinner.Props{Class: "size-3.5"})
				{ formatBytes(loaded) } downloaded…
			</div>
		}
	</div>
}
