package components

import (
	"github.com/pi-bmc/nanokvm-app/ui/components/badge"
	"github.com/pi-bmc/nanokvm-app/ui/components/button"
	"github.com/pi-bmc/nanokvm-app/ui/components/checkbox"
	"github.com/pi-bmc/nanokvm-app/ui/components/icon"
	"github.com/pi-bmc/nanokvm-app/ui/components/input"
)

// ConsoleToolbar is the strip above the serial terminal — connection state,
// connect/disconnect, search, expand, fullscreen. Icon-buttons use SizeIcon
// so the icon centres correctly; Button auto-sizes <svg> children to size-4.
templ ConsoleToolbar() {
	// flex-wrap below sm: the info group (title + device + status badge) and
	// the controls group (Connect + 4 icon buttons) together need ~490px,
	// more than fits beside each other under ~530px wide. Below that they
	// drop to their own rows instead of the controls group spilling past
	// <main>'s overflow-hidden and clipping the Fullscreen button off-screen.
	<div class="flex flex-wrap items-center justify-between gap-y-1.5 rounded-t-md border border-border bg-card px-3 py-1.5 sm:flex-nowrap">
		<div class="flex items-center gap-3">
			<span class="text-xs font-medium">Serial Console</span>
			<span class="text-xs text-muted-foreground">/dev/ttyS1 @ 115200 8N1</span>
			// One badge per connection state, server-styled; setConnStatus
			// swaps the `hidden` DOM property between them. The hidden
			// ATTRIBUTE (not the utility class) is load-bearing: preflight's
			// `[hidden] { display: none !important }` beats the component's
			// own display utility, whereas a `hidden` class both loses that
			// fight at runtime and gets stripped by TwMerge at render.
			@badge.Badge(badge.Props{
				ID:      "conn-status-disconnected",
				Variant: badge.VariantDestructive,
			}) {
				Disconnected
			}
			@badge.Badge(badge.Props{
				ID:         "conn-status-connecting",
				Variant:    badge.VariantSecondary,
				Class:      "bg-yellow-500/15 text-yellow-500",
				Attributes: templ.Attributes{"hidden": true},
			}) {
				Connecting…
			}
			@badge.Badge(badge.Props{
				ID:         "conn-status-connected",
				Variant:    badge.VariantSecondary,
				Class:      "bg-green-500/15 text-green-500",
				Attributes: templ.Attributes{"hidden": true},
			}) {
				Connected
			}
		</div>
		// ml-auto keeps this group pinned to the row's trailing edge whether
		// it shares the line with the info group (desktop) or wraps to its
		// own row (mobile) — justify-between alone only positions items
		// within a shared line, and a lone wrapped item would otherwise
		// collapse to the leading edge.
		<div class="ml-auto flex items-center gap-1">
			// Connect / Disconnect are separate server-styled buttons; the
			// script swaps the `hidden` DOM property instead of rebuilding
			// innerHTML (see the badge comment above for why the attribute).
			@button.Button(button.Props{
				ID:         "btn-serial-connect",
				Variant:    button.VariantOutline,
				Size:       button.SizeSm,
				Class:      "border-green-700 text-green-500",
				Attributes: templ.Attributes{"onclick": "connectSerial()"},
			}) {
				@icon.Plug()
				<span>Connect</span>
			}
			@button.Button(button.Props{
				ID:         "btn-serial-disconnect",
				Variant:    button.VariantDestructive,
				Size:       button.SizeSm,
				Attributes: templ.Attributes{"onclick": "disconnectSerial()", "hidden": true},
			}) {
				@icon.X()
				<span>Disconnect</span>
			}
			@button.Button(button.Props{
				ID:         "btn-search",
				Variant:    button.VariantOutline,
				Size:       button.SizeIcon,
				Class:      "size-8",
				Attributes: templ.Attributes{"onclick": "toggleSearch()", "title": "Search (Ctrl+F)"},
			}) {
				@icon.Search()
			}
			@button.Button(button.Props{
				ID:         "btn-expand",
				Variant:    button.VariantOutline,
				Size:       button.SizeIcon,
				Class:      "size-8",
				Attributes: templ.Attributes{"onclick": "toggleExpand()", "title": "Expand console"},
			}) {
				@icon.Maximize2()
			}
			@button.Button(button.Props{
				ID:         "btn-fullscreen",
				Variant:    button.VariantOutline,
				Size:       button.SizeIcon,
				Class:      "size-8",
				Attributes: templ.Attributes{"onclick": "toggleFullscreen()", "title": "Fullscreen"},
			}) {
				@icon.Expand()
			}
		</div>
	</div>
}

// ConsoleSearchBar appears under the toolbar when the user opens search.
// Hidden by default; the ConsoleScript toggles `hidden` / `flex` utilities.
templ ConsoleSearchBar() {
	<div id="search-bar" class="hidden items-center gap-2 border-x border-b border-border bg-card px-3 py-1.5">
		<div class="flex-1 max-w-xs">
			@input.Input(input.Props{
				ID:          "search-input",
				Placeholder: "Search terminal…",
				Class:       "h-8 text-xs",
				Attributes:  templ.Attributes{"autocomplete": "off", "spellcheck": "false", "oninput": "onSearchInput()", "onkeydown": "onSearchKeydown(event)"},
			})
		</div>
		<span id="search-count" class="min-w-12 text-center text-xs text-muted-foreground select-none"></span>
		<div class="ml-auto flex items-center gap-2">
			// change fires on the checkbox's hidden input and bubbles to the
			// label; the ids stay on the inputs so buildSearchOpts reads
			// .checked unchanged.
			<label class="flex items-center gap-1 text-xs text-muted-foreground cursor-pointer select-none" title="Case sensitive" onchange="onSearchInput()">
				@checkbox.Checkbox(checkbox.Props{ID: "search-case"})
				Aa
			</label>
			<label class="flex items-center gap-1 text-xs text-muted-foreground cursor-pointer select-none" title="Regular expression" onchange="onSearchInput()">
				@checkbox.Checkbox(checkbox.Props{ID: "search-regex"})
				.*
			</label>
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeIcon, Class: "size-7", Attributes: templ.Attributes{"onclick": "findPrevious()", "title": "Previous match (Shift+Enter)"}}) {
				@icon.ChevronUp()
			}
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeIcon, Class: "size-7", Attributes: templ.Attributes{"onclick": "findNext()", "title": "Next match (Enter)"}}) {
				@icon.ChevronDown()
			}
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeIcon, Class: "size-7", Attributes: templ.Attributes{"onclick": "closeSearch()", "title": "Close (Esc)"}}) {
				@icon.X()
			}
		</div>
	</div>
}
