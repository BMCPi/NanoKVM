package components

import (
	"github.com/pi-bmc/nanokvm-app/ui/components/button"
	"github.com/pi-bmc/nanokvm-app/ui/components/icon"
	"github.com/pi-bmc/nanokvm-app/ui/components/separator"
)

// Navbar is a single top bar. The Serial Console panel below acts as the
// contextual second bar (mirrors JetKVM / PiKVM's dual-bar pattern).
//
// Left cluster:  brand → Power ▾ → Virtual Media ▾ → divider → Server Overview
// Right cluster: BIOS → API Docs → Settings → Logout
templ Navbar(onDocsPage bool) {
	// h-11 rather than an inline height: 2.75rem is exactly h-11, and this was
	// the only inline style left in the app.
	<header class="flex h-11 shrink-0 items-center justify-between gap-1 border-b border-border bg-card px-3">
		// Left cluster: Brand + Power + Overview
		<div class="flex items-center gap-1.5">
			<a href="/" class="flex items-center gap-2 mr-2 shrink-0 group" title="NanoKVM BMC" aria-label="NanoKVM BMC">
				<img src="/img/favicon.ico" alt="NanoKVM BMC" class="size-5 transition-transform group-hover:scale-105"/>
				<span class="font-semibold text-sm tracking-tight hidden md:inline">NanoKVM <span class="text-xs text-muted-foreground font-normal">BMC</span></span>
			</a>
			@PowerMenu()
			// The vendored Separator rather than a hand-rolled hairline div, in
			// the shape shadcn-templ's own site headers use it. It defaults to
			// data-vertical:self-stretch (full header height), so the short rule
			// needs data-vertical:self-auto to cancel it — and the variant prefix
			// has to match for TwMerge to treat the two as one conflict group and
			// drop the base class. A plain `self-auto` would survive alongside
			// self-stretch and then lose: the generated self-stretch rule sorts
			// after it, so cascade order alone does not save it.
			@separator.Separator(separator.Props{
				Orientation: separator.OrientationVertical,
				Class:       "mx-1 h-3.5 data-vertical:self-auto",
			})
			@button.Button(button.Props{
				Variant: button.VariantGhost,
				Size:    button.SizeSm,
				Attributes: templ.Attributes{
					"onclick":    "toggleOverview()",
					"aria-label": "Server Overview",
					"title":      "Server Overview",
				},
			}) {
				@icon.MonitorSpeaker()
				<span class="hidden sm:inline">Server Overview</span>
			}
		</div>
		// Right cluster: Global Tools + API Docs + Settings + Logout
		<div class="flex items-center gap-0.5 shrink-0">
			if onDocsPage {
				@button.Button(button.Props{
					Variant: button.VariantGhost,
					Size:    button.SizeSm,
					Href:    "/",
					Attributes: templ.Attributes{
						"aria-label": "Dashboard",
						"title":      "Back to dashboard",
					},
				}) {
					@icon.LayoutDashboard()
					<span class="hidden sm:inline">Dashboard</span>
				}
			} else {
				@BiosDialogTrigger()
				@button.Button(button.Props{
					Variant: button.VariantGhost,
					Size:    button.SizeSm,
					Href:    "/docs",
					Attributes: templ.Attributes{
						"target":     "_blank",
						"rel":        "noopener noreferrer",
						"aria-label": "API Docs",
						"title":      "Redfish API documentation",
					},
				}) {
					@icon.BookOpen()
					<span class="hidden sm:inline">API Docs</span>
				}
			}
			@SettingsDialogTrigger()
			@button.Button(button.Props{
				Variant:    button.VariantGhost,
				Size:       button.SizeIcon,
				Attributes: templ.Attributes{"onclick": "doLogout()", "aria-label": "Logout", "title": "Logout"},
			}) {
				@icon.LogOut()
			}
		</div>
	</header>
	@navbarScript()
}

templ navbarScript() {
	<script>
		async function doLogout() {
			try { await apiPost('/api/auth/logout'); } catch(e) {}
			deleteCookie('nano-kvm-token');
			window.location.replace('/auth/login');
		}
	</script>
}

