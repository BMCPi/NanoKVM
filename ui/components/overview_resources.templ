package components

import "github.com/pi-bmc/nanokvm-app/ui/components/card"

// overviewResourcesCard is what the BMC itself is using: processor, memory and
// the writable data volume.
//
// The BMC's, not the managed host's — the host runs UEFI firmware, which
// reports no live utilisation over the Redfish host interface. That is worth
// being explicit about in the card's own description rather than leaving an
// operator to infer which machine these numbers describe.
//
// Lazy for the same reason the Activity card is (see overviewActivityCard):
// the figures move, so rendering them with the page would show an hour-old
// reading to whoever finally opens the drawer.
templ overviewResourcesCard() {
	@card.Card(card.Props{Class: overviewCardClass}) {
		@card.Header(card.HeaderProps{Class: "gap-1"}) {
			@card.Title(card.TitleProps{Class: SectionLabelClass}) {
				Resources
			}
			@card.Description(card.DescriptionProps{Class: "text-xs"}) {
				Processor, memory and storage on the BMC itself.
			}
		}
		// Two triggers. The open event is the first render; the poll is what
		// keeps a graph from freezing the moment someone opens the drawer to
		// watch it — overview-opened fires on a state *transition*, so on its
		// own it renders once and never again. The filter is what makes the
		// poll affordable: htmx evaluates it before issuing the request, so a
		// closed drawer costs one predicate call every ten seconds and no
		// round trip at all. Ten seconds because that is the sample interval;
		// polling faster would re-render the same ring.
		<div
			class="contents"
			hx-get="/ui/overview/resources"
			hx-trigger="overview-opened from:body, every 10s [isOverviewOpen()]"
		>
			@OverviewResourcesBody(OverviewResources{})
		</div>
	}
}

// OverviewResourcesBody renders the three graphs, or says why there are none.
templ OverviewResourcesBody(m OverviewResources) {
	@card.Content() {
		if !m.Sampling {
			<p class="text-xs text-muted-foreground">
				Collecting. The first readings appear within a minute of boot.
			</p>
		} else {
			<div class="flex flex-col gap-3">
				for _, s := range m.Series() {
					@resourceGraph(s)
				}
			</div>
		}
	}
	@card.Footer(card.FooterProps{Class: "text-xs text-muted-foreground"}) {
		Sampled every 10s · last 30 minutes.
	}
}

// resourceGraph is one labelled trace: the reading above, the trend below.
//
// Deliberately not statusRow's two-column grid. That grid exists so a column of
// values can be read straight down; here each value belongs to the graph
// directly under it, and pushing the reading into a 7.5rem gutter would part it
// from the thing it labels to align it with rows in a different card.
templ resourceGraph(s ResourceSeries) {
	<div class="flex flex-col gap-1">
		<div class="flex items-baseline justify-between gap-2">
			<span class="shrink-0 text-xs text-muted-foreground">{ s.Label }</span>
			<span class="flex items-baseline gap-2 font-mono text-xs">
				if s.Detail != "" {
					<span class="text-muted-foreground">{ s.Detail }</span>
				}
				<span
					class={ "tabular-nums",
						templ.KV("text-destructive", s.Elevated()),
						templ.KV("text-foreground", !s.Elevated()) }
				>
					{ s.PercentLabel() }
				</span>
			</span>
		</div>
		@sparkline(s)
	</div>
}

// sparkline draws one trace against a fixed 0..100 box.
//
// preserveAspectRatio="none" lets the square viewBox stretch to whatever width
// the drawer is at whatever height the class sets, which is what makes the
// graph reflow with the panel without measuring anything. The distortion that
// would otherwise smear the stroke is undone by vector-effect, which keeps it
// at one device pixel regardless of the scale factor.
//
// aria-hidden with the reading in a sibling: the number above is the accessible
// content, and a screen reader gains nothing from a path element.
templ sparkline(s ResourceSeries) {
	<svg
		class={ "h-8 w-full overflow-hidden rounded-sm bg-muted/40",
			templ.KV("text-destructive", s.Elevated()),
			templ.KV("text-primary", !s.Elevated()) }
		viewBox="0 0 100 100"
		preserveAspectRatio="none"
		aria-hidden="true"
		focusable="false"
	>
		// The half-height rule is the only gridline. With the domain fixed it
		// is always 50%, so it reads as a scale rather than as data.
		<line
			x1="0"
			y1="50"
			x2="100"
			y2="50"
			stroke="currentColor"
			stroke-opacity="0.15"
			stroke-width="1"
			vector-effect="non-scaling-stroke"
		></line>
		<polygon points={ sparkPolygon(s.Points) } fill="currentColor" fill-opacity="0.2"></polygon>
		<polyline
			points={ sparkPolyline(s.Points) }
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linejoin="round"
			vector-effect="non-scaling-stroke"
		></polyline>
	</svg>
}
