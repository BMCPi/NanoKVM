package components

import "github.com/pi-bmc/nanokvm-app/ui/components/card"

// overviewResourcesCard is what the BMC itself is using: processor, memory and
// the writable data volume.
//
// The BMC's, not the managed host's — the host runs UEFI firmware, which
// reports no live utilisation over the Redfish host interface. That is worth
// being explicit about in the card's own description rather than leaving an
// operator to infer which machine these numbers describe.
//
// Lazy for the same reason the Activity card is (see overviewActivityCard):
// the figures move, so rendering them with the page would show an hour-old
// reading to whoever finally opens the drawer.
templ overviewResourcesCard() {
	@card.Card(card.Props{Class: overviewCardClass}) {
		@card.Header(card.HeaderProps{Class: "gap-1"}) {
			@card.Title(card.TitleProps{Class: SectionLabelClass}) {
				Resources
			}
			@card.Description(card.DescriptionProps{Class: "text-xs"}) {
				Processor, memory and storage on the BMC itself.
			}
		}
		// Two triggers. The open event is the first render; the poll is what
		// keeps a graph from freezing the moment someone opens the drawer to
		// watch it — overview-opened fires on a state *transition*, so on its
		// own it renders once and never again. The filter is what makes the
		// poll affordable: htmx evaluates it before issuing the request, so a
		// closed drawer costs one predicate call every ten seconds and no
		// round trip at all. Ten seconds because that is the sample interval;
		// polling faster would re-render the same ring.
		<div
			class="contents"
			hx-get="/ui/overview/resources"
			hx-trigger="overview-opened from:body, every 10s [isOverviewOpen()]"
		>
			@OverviewResourcesBody(OverviewResources{})
		</div>
	}
}

// OverviewResourcesBody renders the three graphs, or says why there are none.
templ OverviewResourcesBody(m OverviewResources) {
	@card.Content() {
		if !m.Sampling {
			<p class="text-xs text-muted-foreground">
				Collecting. The first readings appear within a minute of boot.
			</p>
		} else {
			<div class="flex flex-col gap-3">
				for _, s := range m.Series() {
					@sparkGraph(s)
				}
			</div>
		}
	}
	@card.Footer(card.FooterProps{Class: "text-xs text-muted-foreground"}) {
		Sampled every 10s · last 30 minutes.
	}
}
