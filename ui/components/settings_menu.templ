package components

import (
	"github.com/pi-bmc/nanokvm-app/ui/components/button"
	"github.com/pi-bmc/nanokvm-app/ui/components/card"
	"github.com/pi-bmc/nanokvm-app/ui/components/dialog"
	"github.com/pi-bmc/nanokvm-app/ui/components/field"
	"github.com/pi-bmc/nanokvm-app/ui/components/icon"
	"github.com/pi-bmc/nanokvm-app/ui/components/input"
	selectcomp "github.com/pi-bmc/nanokvm-app/ui/components/select"
	switchcomp "github.com/pi-bmc/nanokvm-app/ui/components/switch"
	"github.com/pi-bmc/nanokvm-app/ui/components/textarea"
	"github.com/pi-bmc/nanokvm-app/ui/utils"
)

// The settings dialog is server-rendered end to end: every panel body is a
// fragment served by ui/fragments_settings.go, every write is a plain <form>
// that htmx submits and answers with the re-rendered panel. Nothing in this
// file reads or writes state from JavaScript — the only script left handles
// local view state (which panel is showing, the static-address reveal, and the
// clipboard), none of which touches the wire.

// settingsTriggerID is the navbar button. Panel bodies bind their load to a
// click on it (hx-trigger="click from:#…"), so a dialog that is never opened
// costs no requests, and every open re-reads live state.
const settingsTriggerID = "settings-open-trigger"

// settingsSection is one entry in the dialog's left nav rail. The list lives
// in Go so the rail and the panels cannot drift apart.
type settingsSection struct {
	ID    string
	Label string
	Icon  func(...icon.Props) templ.Component
}

var settingsSections = []settingsSection{
	{ID: "general", Label: "General", Icon: icon.SlidersHorizontal},
	{ID: "network", Label: "Network", Icon: icon.Network},
	{ID: "hardware", Label: "Hardware", Icon: icon.Usb},
	{ID: "access", Label: "Access", Icon: icon.ShieldCheck},
	{ID: "advanced", Label: "Advanced", Icon: icon.Wrench},
}

// SettingsDialogTrigger is the navbar button that opens the settings dialog.
// Lives separately from the dialog body so dialog state survives across
// navbar re-renders / page loads.
templ SettingsDialogTrigger() {
	@button.Button(button.Props{
		ID:      settingsTriggerID,
		Variant: button.VariantGhost,
		Size:    button.SizeSm,
		Attributes: utils.MergeAttributes(
			dialog.TriggerFor("settings-dialog"),
			templ.Attributes{
				"title":      "Settings",
				"aria-label": "Settings",
			},
		),
	}) {
		@icon.Settings()
	}
}

// SettingsDialog is the modal settings panel, laid out like JetKVM's settings
// pane: a nav rail on the left (Back to KVM + one entry per section) and a
// single card on the right whose header carries the section title, its
// one-line description and the section's primary action. Rendered once near
// the root and triggered from the navbar via
// dialog.TriggerFor("settings-dialog").
templ SettingsDialog() {
	@dialog.Dialog(dialog.Props{ID: "settings-dialog"}) {
		// The backdrop keeps its normal dim + blur (like every other dialog —
		// no OverlayClass override here). It's this outer wrapper's OWN fill
		// that goes transparent, like the reference pane: the blurred page
		// shows through the gap around the nav rail and content card, while
		// each of those keeps its own bg-card/bg-muted surface (from card.Card
		// below) so they still read as distinct raised panels.
		@dialog.Content(dialog.ContentProps{
			HideCloseButton: true,
			Class:           "bg-transparent shadow-none ring-0 flex flex-col gap-0 p-3 sm:max-w-3xl lg:max-w-5xl h-[min(46rem,calc(100svh-3rem))]",
		}) {
			// The visible headings live in each panel, so the dialog's own
			// title/description — what aria-labelledby/-describedby point at —
			// are screen-reader only.
			@dialog.Header(dialog.HeaderProps{Class: "sr-only"}) {
				@dialog.Title() {
					Settings
				}
				@dialog.Description() {
					Configure general, network, hardware, access and advanced settings.
				}
			}
			<div class="flex min-h-0 flex-1 flex-col gap-3 sm:flex-row">
				@settingsNav()
				<div class="flex min-h-0 min-w-0 flex-1 flex-col">
					@settingsGeneralPanel()
					@settingsNetworkPanel()
					@settingsHardwarePanel()
					@settingsAccessPanel()
					@settingsAdvancedPanel()
				</div>
			</div>
		}
	}
	@settingsDialogScript()
}

// settingsNav is the left rail: the dismiss button over a card of section
// links, mirroring the reference pane's "Back to KVM" + section list.
templ settingsNav() {
	<nav class="flex shrink-0 flex-col gap-3 sm:w-52" aria-label="Settings sections">
		@button.Button(button.Props{
			Variant:    button.VariantOutline,
			Class:      "w-full justify-start gap-2",
			Attributes: dialog.Close(ctx),
		}) {
			@icon.ArrowLeft()
			<span>Back to KVM</span>
		}
		@card.Card(card.Props{Class: "gap-0.5 p-1"}) {
			for i, s := range settingsSections {
				@settingsNavItem(s, i == 0)
			}
		}
	</nav>
}

// settingsNavItem is one section link. The active state rides on data-active
// rather than a class swap: the attribute selector outranks the variant's own
// background, so the highlight survives hover without an !important.
templ settingsNavItem(s settingsSection, active bool) {
	@button.Button(button.Props{
		Variant: button.VariantGhost,
		Size:    button.SizeSm,
		Class:   "w-full justify-start gap-2 font-normal text-muted-foreground data-[active=true]:bg-muted data-[active=true]:font-medium data-[active=true]:text-foreground",
		Attributes: templ.Attributes{
			"data-settings-nav": s.ID,
			"data-active":       utils.IfElse(active, "true", "false"),
			"onclick":           "showSettingsSection('" + s.ID + "')",
		},
	}) {
		@s.Icon(icon.Props{Class: "size-4"})
		<span>{ s.Label }</span>
	}
}

// settingsPanel is the right-hand pane for one section. action is the
// header's top-right control (a Save button for the sections that batch
// their writes) and may be nil.
templ settingsPanel(id, title, description string, active bool, action templ.Component) {
	<section
		data-settings-panel={ id }
		data-active={ utils.IfElse(active, "true", "false") }
		aria-label={ title }
		class="flex min-h-0 flex-1 flex-col data-[active=false]:hidden"
	>
		@card.Card(card.Props{Class: "min-h-0 flex-1"}) {
			@card.Header() {
				@card.Title() {
					{ title }
				}
				@card.Description() {
					{ description }
				}
				if action != nil {
					@card.Action() {
						@action
					}
				}
			}
			@card.Content(card.ContentProps{Class: "no-scrollbar min-h-0 flex-1 overflow-y-auto"}) {
				{ children... }
			}
		}
	</section>
}

// settingsBody wraps a panel's swappable region. It loads itself from path
// when the settings trigger is clicked, and is the target every write in that
// panel answers with, so the panel always shows persisted state.
templ settingsBody(id, path string) {
	<div
		id={ id }
		hx-get={ path }
		hx-trigger={ "click from:#" + settingsTriggerID }
		hx-swap="innerHTML"
	>
		{ children... }
	</div>
}

// ── Panels ──────────────────────────────────────────────────────────────

templ settingsGeneralPanel() {
	@settingsPanel("general", "General", "Device identity and automatic updates.", true, nil) {
		@settingsBody("settings-general-body", "/ui/settings/general") {
			@SettingsGeneralBody(SettingsGeneral{})
		}
	}
}

// SettingsGeneralBody is the General panel's swappable region. The
// auto-update form has no Save button: hx-trigger="change" writes on every
// toggle and answers with this same body re-rendered from the saved config.
templ SettingsGeneralBody(m SettingsGeneral) {
	@field.Group() {
		@field.Set() {
			@field.Legend(field.LegendProps{Variant: field.LegendVariantLabel}) {
				Device
			}
			@settingsValueRow("Application", "BMC application build currently running.", m.AppVersion)
			@settingsValueRow("System image", "Base image the BMC booted from.", m.ImageVersion)
			@settingsValueRow("Hardware", "Detected NanoKVM hardware revision.", m.Hardware)
		}
		<form
			hx-patch="/ui/settings/autoupdate"
			hx-trigger="change"
			hx-target="#settings-general-body"
			hx-swap="innerHTML"
			class="contents"
		>
			@field.Set() {
				@field.Legend(field.LegendProps{Variant: field.LegendVariantLabel}) {
					Automatic updates
				}
				@settingsSwitchRow("au-enabled", "enabled", "Enable auto-update",
					"Check GitHub for newer releases in the background and apply them.", m.AutoUpdateEnabled)
				@settingsRow("au-interval", "Check interval",
					"Minutes between checks. Values below 5 are clamped at runtime.") {
					@input.Input(input.Props{
						ID:         "au-interval",
						Name:       "intervalMinutes",
						Type:       "number",
						Value:      m.AutoUpdateInterval,
						Class:      "w-24",
						Attributes: templ.Attributes{"min": "5", "step": "5"},
					})
				}
				@settingsSwitchRow("au-application", "application", "Update application",
					"Apply new NanoKVM application releases. The service restarts.", m.AutoUpdateApplication)
				@settingsSwitchRow("au-bios", "bios", "Update BIOS (U-Boot)",
					"Apply new U-Boot images for the managed host.", m.AutoUpdateBIOS)
			}
		</form>
	}
}

templ settingsNetworkPanel() {
	@settingsPanel(
		"network", "Network", "Configure your network settings.", false,
		settingsSubmitButton("settings-network-form", "Save Settings"),
	) {
		@settingsBody("settings-network-body", "/ui/settings/network") {
			@SettingsNetworkBody(SettingsNetwork{Mode: "dhcp"})
		}
	}
}

// SettingsNetworkBody is the Network panel's swappable region: one form for
// the whole addressing config, submitted by the Save button in the panel
// header (associated by the form= attribute, since the header sits outside
// the swapped region). The response is this body re-rendered from the config
// the server actually persisted, so a rejected value never lingers on screen.
templ SettingsNetworkBody(m SettingsNetwork) {
	<form
		id="settings-network-form"
		hx-patch="/ui/settings/network"
		hx-target="#settings-network-body"
		hx-swap="innerHTML"
		hx-confirm="Re-applies addressing immediately and may interrupt this session."
		data-confirm-title="Save network settings?"
		data-confirm-label="Save"
	>
		@field.Group() {
			@field.Set() {
				@field.Legend(field.LegendProps{Variant: field.LegendVariantLabel}) {
					Wired uplink (eth0)
				}
				@settingsSwitchRow("net-enabled", "enabled", "Managed networking",
					"Let the BMC configure eth0 over netlink instead of leaving it to the boot scripts.", m.Enabled)
				@settingsRowWide("net-mac", "MAC Address",
					"Hardware identifier for the network interface. Blank keeps the kernel MAC.") {
					@input.Input(input.Props{
						ID:          "net-mac",
						Name:        "mac",
						Value:       m.MAC,
						Placeholder: "aa:bb:cc:dd:ee:ff",
						Class:       "w-full @md/field-group:w-48 font-mono",
						Attributes:  templ.Attributes{"spellcheck": "false", "autocomplete": "off"},
					})
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Size:       button.SizeIcon,
						Attributes: templ.Attributes{"onclick": "copySettingsValue('net-mac')", "title": "Copy", "aria-label": "Copy MAC address"},
					}) {
						@icon.Copy()
					}
				}
				@settingsRow("net-mode-trigger", "IPv4 Mode", "Configure the IPv4 mode.") {
					@selectcomp.Select(selectcomp.Props{ID: "net-mode", Name: "mode", Value: m.Mode}) {
						@selectcomp.Trigger(selectcomp.TriggerProps{ID: "net-mode-trigger", Class: "w-32"}) {
							@selectcomp.Value(selectcomp.ValueProps{Placeholder: "DHCP"})
						}
						@selectcomp.Content() {
							@selectcomp.Item(selectcomp.ItemProps{Value: "dhcp"}) {
								DHCP
							}
							@selectcomp.Item(selectcomp.ItemProps{Value: "static"}) {
								Static
							}
						}
					}
				}
				// Static-only fields. data-active drives the visibility so the
				// attribute selector wins over the row's own display utility;
				// the reveal is local view state, not a server round trip.
				<div
					id="net-static"
					data-active={ utils.IfElse(m.IsStatic(), "true", "false") }
					class="flex flex-col gap-4 data-[active=false]:hidden"
				>
					@settingsRowWide("net-address", "IPv4 Address", "Static address in CIDR notation, e.g. 192.168.1.50/24.") {
						@settingsTextInput("net-address", "address", m.Address, "192.168.1.50/24")
					}
					@settingsRowWide("net-gateway", "Gateway", "Default-route next hop. Blank adds no default route.") {
						@settingsTextInput("net-gateway", "gateway", m.Gateway, "192.168.1.1")
					}
					@settingsRowWide("net-dns", "DNS Servers", "Nameservers written to /etc/resolv.conf, comma separated.") {
						@settingsTextInput("net-dns", "dns", m.DNS, "1.1.1.1, 9.9.9.9")
					}
				</div>
			}
			@field.Set() {
				@field.Legend(field.LegendProps{Variant: field.LegendVariantLabel}) {
					USB host interface
				}
				@settingsRowWide("rhi-address", "BMC Address",
					"Link-local CIDR the BMC takes on the USB link to the managed host.") {
					@settingsTextInput("rhi-address", "rhiAddress", m.RHIAddress, "169.254.10.1/16")
				}
				@settingsRowWide("rhi-lease", "Host Lease",
					"Single address offered to the host. Blank disables the DHCP server.") {
					@settingsTextInput("rhi-lease", "rhiLease", m.RHILease, "169.254.10.2")
				}
			}
			@settingsNetworkStatusCard(m.Status)
		}
	</form>
}

// settingsNetworkStatusCard is the read-only counterpart of the form above —
// what the interfaces actually ended up with. bg-background keeps it distinct
// from the panel card it sits in. Its Refresh button re-reads just this card.
templ settingsNetworkStatusCard(s SettingsNetworkStatus) {
	@card.Card(card.Props{Size: card.SizeSm, Class: "bg-background"}) {
		@card.Header() {
			@card.Title(card.TitleProps{Class: "text-xs"}) {
				Network Status
			}
			@card.Action() {
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Attributes: templ.Attributes{
						"hx-get":     "/ui/settings/network/status",
						"hx-target":  "#settings-network-status",
						"hx-swap":    "innerHTML",
						"aria-label": "Refresh network status",
					},
				}) {
					@icon.RefreshCw()
					<span>Refresh</span>
				}
			}
		}
		@card.Content(card.ContentProps{ID: "settings-network-status", Class: "grid grid-cols-1 gap-x-6 sm:grid-cols-2"}) {
			@SettingsNetworkStatusRows(s)
		}
	}
}

// SettingsNetworkStatusRows is swapped on its own by the Refresh button.
templ SettingsNetworkStatusRows(s SettingsNetworkStatus) {
	@settingsStatusRow("IP Address", s.IP)
	@settingsStatusRow("Interface", s.Interface)
	@settingsStatusRow("IPv4 Mode", s.Mode)
	@settingsStatusRow("MAC Address", s.MAC)
	@settingsStatusRow("mDNS Name", s.MDNS)
	@settingsStatusRow("USB Host Link", s.RHI)
}

templ settingsHardwarePanel() {
	@settingsPanel("hardware", "Hardware", "USB gadget functions exposed to the managed host.", false, nil) {
		@settingsBody("settings-hardware-body", "/ui/settings/hardware") {
			@SettingsHardwareBody(SettingsHardware{})
		}
	}
}

// SettingsHardwareBody applies each toggle immediately. The handler reconciles
// against live gadget state, so the switch says what the gadget is actually
// doing rather than what was clicked.
templ SettingsHardwareBody(m SettingsHardware) {
	<form
		hx-post="/ui/settings/hardware"
		hx-trigger="change"
		hx-target="#settings-hardware-body"
		hx-swap="innerHTML"
	>
		@field.Group() {
			@settingsSwitchRow("usb-network", "network", "USB Ethernet",
				"Present a CDC-ECM adapter to the host — the transport for the Redfish host interface.", m.USBNetwork)
			@settingsSwitchRow("usb-disk", "disk", "USB Mass Storage",
				"Present the BMC's disk image to the host as a USB drive.", m.USBDisk)
			@settingsValueRow("Virtual media", "Whether an ISO is currently attached to the host.", m.MediaState)
		}
	</form>
}

templ settingsAccessPanel() {
	@settingsPanel("access", "Access", "Who can reach the BMC, and how.", false, nil) {
		@settingsBody("settings-access-body", "/ui/settings/access") {
			@SettingsAccessBody(SettingsAccess{})
		}
	}
}

// SettingsAccessBody keeps one form per action rather than one per panel: a
// keys edit must not restart the service the way flipping TLS does, and the
// SSH listener rolls its own state back when the port is taken, so each write
// answers with the panel re-read from what actually stuck.
templ SettingsAccessBody(m SettingsAccess) {
	@field.Group() {
		@field.Set() {
			@field.Legend(field.LegendProps{Variant: field.LegendVariantLabel}) {
				SSH
			}
			<form
				hx-post="/ui/settings/access/ssh"
				hx-trigger="change"
				hx-target="#settings-access-body"
				hx-swap="innerHTML"
				class="contents"
			>
				@settingsSwitchRow("ssh-switch", "enabled", "SSH server",
					"In-process SSH server on port 22. Log in as root.", m.SSHEnabled)
			</form>
			<form
				hx-post="/ui/settings/access/ssh/keys"
				hx-target="#settings-access-body"
				hx-swap="innerHTML"
				class="contents"
			>
				@field.Field() {
					@field.Label(field.LabelProps{For: "ssh-keys"}) {
						Authorized Keys
					}
					@field.Description() {
						One public key per line, OpenSSH format.
					}
					@textarea.Textarea(textarea.Props{
						ID:          "ssh-keys",
						Name:        "sshKey",
						Value:       m.SSHKeys,
						Rows:        4,
						Placeholder: "ssh-ed25519 AAAA… user@host",
						Class:       "font-mono text-xs",
						Attributes:  templ.Attributes{"spellcheck": "false", "autocomplete": "off"},
					})
					<div class="flex items-center justify-end gap-2">
						@button.Button(button.Props{
							Type:    button.TypeSubmit,
							Variant: button.VariantOutline,
							Size:    button.SizeSm,
						}) {
							Save Keys
						}
					</div>
				}
			</form>
		}
		@field.Set() {
			@field.Legend(field.LegendProps{Variant: field.LegendVariantLabel}) {
				Web interface
			}
			<form
				hx-post="/ui/settings/access/tls"
				hx-trigger="change"
				hx-target="#settings-access-body"
				hx-swap="innerHTML"
				hx-confirm="The service restarts and the page reloads on the new scheme."
				data-confirm-title="Change the web protocol?"
				data-confirm-label="Restart"
				class="contents"
			>
				@settingsSwitchRow("tls-switch", "enabled", "TLS / HTTPS",
					"Serve the web UI and the APIs over HTTPS.", m.TLSEnabled)
			</form>
			@settingsRow("", "Password", "Change the password of the BMC web account.") {
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Href:    "/auth/password",
				}) {
					@icon.KeyRound()
					<span>Change Password</span>
				}
			}
		}
	}
}

templ settingsAdvancedPanel() {
	@settingsPanel("advanced", "Advanced", "Maintenance and diagnostics.", false, nil) {
		@settingsBody("settings-advanced-body", "/ui/settings/advanced") {
			@SettingsAdvancedBody(SettingsAdvanced{})
		}
	}
}

templ SettingsAdvancedBody(m SettingsAdvanced) {
	@field.Group() {
		@settingsRow("", "Reboot BMC",
			"Restart the management controller. The managed host keeps running.") {
			@button.Button(button.Props{
				Variant: button.VariantDestructive,
				Size:    button.SizeSm,
				Attributes: templ.Attributes{
					"hx-post":                   "/ui/settings/reboot",
					"hx-swap":                   "none",
					"hx-confirm":                "The management controller restarts; this page will stop responding for about a minute.",
					"data-confirm-title":        "Reboot the BMC?",
					"data-confirm-label":        "Reboot",
					"data-confirm-destructive":  "",
				},
			}) {
				@icon.RefreshCw()
				<span>Reboot BMC</span>
			}
		}
		@settingsRow("", "API documentation",
			"Rendered reference for the Redfish and NanoKVM APIs served by this device.") {
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Size:    button.SizeSm,
				Href:    "/docs",
				Target:  "_blank",
				Attributes: templ.Attributes{
					"rel": "noopener noreferrer",
				},
			}) {
				@icon.BookOpen()
				<span>Open Docs</span>
			}
		}
		@settingsValueRow("Device key", "Per-device identifier baked into the image.", m.DeviceKey)
	}
}

// ── Row primitives ──────────────────────────────────────────────────────

// settingsRow is the reference pane's row shape: title over a one-line
// description on the left, the control on the right. forID associates the
// title with the control; pass "" when the control is not labelable.
templ settingsRow(forID, title, description string) {
	@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
		@field.Content() {
			if forID != "" {
				@field.Label(field.LabelProps{For: forID}) {
					{ title }
				}
			} else {
				@field.Title() {
					{ title }
				}
			}
			@field.Description() {
				{ description }
			}
		}
		<div class="flex shrink-0 items-center gap-2">
			{ children... }
		</div>
	}
}

// settingsRowWide is settingsRow for the free-text address/MAC rows: their
// descriptions run long enough (e.g. "Link-local CIDR the BMC takes on the
// USB link to the managed host.") that sharing a horizontal row with even a
// modest input leaves the label+description column too narrow on mobile —
// confirmed at 500px: MAC Address wrapped to 128.5px tall in a 128px-wide
// column. Responsive orientation stacks label/description above the control
// below the field-group's own @md container-query breakpoint (~448px) and
// stays side-by-side above it, so desktop is unchanged.
templ settingsRowWide(forID, title, description string) {
	@field.Field(field.Props{Orientation: field.OrientationResponsive}) {
		@field.Content() {
			if forID != "" {
				@field.Label(field.LabelProps{For: forID}) {
					{ title }
				}
			} else {
				@field.Title() {
					{ title }
				}
			}
			@field.Description() {
				{ description }
			}
		}
		<div class="flex shrink-0 items-center gap-2">
			{ children... }
		</div>
	}
}

// settingsSwitchRow is a row whose control is a switch. name is the form field
// the enclosing form submits; an unchecked switch submits nothing, which the
// handlers read as false.
templ settingsSwitchRow(id, name, title, description string, checked bool) {
	@settingsRow(id, title, description) {
		@switchcomp.Switch(switchcomp.Props{ID: id, Name: name, Value: "true", Checked: checked})
	}
}

// settingsTextInput is the monospace text field the addressing rows use.
// Only ever placed inside settingsRowWide, so the width tracks that same
// field-group container query: full width once the row has stacked (no
// label column competing for space), fixed width once it hasn't.
templ settingsTextInput(id, name, value, placeholder string) {
	@input.Input(input.Props{
		ID:          id,
		Name:        name,
		Value:       value,
		Placeholder: placeholder,
		Class:       "w-full @md/field-group:w-48 font-mono",
		Attributes:  templ.Attributes{"spellcheck": "false", "autocomplete": "off"},
	})
}

// settingsSubmitButton is a panel header's Save control. It submits a form in
// the swapped body below via the form= attribute, so re-rendering the body
// never replaces the button.
templ settingsSubmitButton(formID, label string) {
	@button.Button(button.Props{
		Type: button.TypeSubmit,
		Size: button.SizeSm,
		Form: formID,
	}) {
		{ label }
	}
}

// settingsValueRow is a read-only row.
templ settingsValueRow(title, description, value string) {
	@settingsRow("", title, description) {
		<span class="font-mono text-xs">
			if value != "" {
				{ value }
			} else {
				—
			}
		</span>
	}
}

// settingsStatusRow is one entry of the network status grid: muted label on
// the left, value on the right, hairline between rows.
templ settingsStatusRow(label, value string) {
	<div class="flex items-center justify-between gap-2 border-b border-border/50 py-1 last:border-0">
		<span class="text-muted-foreground">{ label }</span>
		<span class="truncate font-mono">
			if value != "" {
				{ value }
			} else {
				—
			}
		</span>
	</div>
}

// settingsDialogScript is what is left after the migration: local view state
// only. Panel switching and the static-address reveal never leave the browser,
// and the clipboard has no server side at all.
templ settingsDialogScript() {
	<script>
		function showSettingsSection(id) {
			document.querySelectorAll('[data-settings-panel]').forEach((p) => {
				p.dataset.active = String(p.dataset.settingsPanel === id);
			});
			document.querySelectorAll('[data-settings-nav]').forEach((b) => {
				b.dataset.active = String(b.dataset.settingsNav === id);
			});
		}

		// navigator.clipboard needs a secure context and the BMC serves plain
		// HTTP by default, so fall back to the selection-based copy there.
		function copySettingsValue(id) {
			const el = document.getElementById(id);
			if (!el || !el.value) return;
			if (navigator.clipboard && window.isSecureContext) {
				navigator.clipboard.writeText(el.value);
				return;
			}
			el.select();
			try { document.execCommand('copy'); } catch(e) {}
			el.setSelectionRange(el.value.length, el.value.length);
		}

		// The static-address fields follow the IPv4 Mode select without a round
		// trip, so switching modes never discards half-typed addresses.
		// select.js dispatches change on its hidden input; the listener is
		// delegated because htmx replaces that input on every swap.
		document.addEventListener('change', (e) => {
			const t = e.target;
			if (!t || !t.matches || !t.matches('input[data-tui-select-input][name="mode"]')) return;
			const el = document.getElementById('net-static');
			if (el) el.dataset.active = String(t.value === 'static');
		});
	</script>
}
