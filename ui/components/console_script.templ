package components

// ConsoleScript wires xterm.js to the /api/vm/terminal WebSocket and
// implements search / expand / fullscreen. Lives in its own component so
// dashboard.templ stays focused on layout.
templ ConsoleScript() {
	<script>
		const Terminal = window.Terminal;
		const FitAddon = window.FitAddon?.FitAddon || window.FitAddon;
		const AttachAddon = window.AttachAddon?.AttachAddon || window.AttachAddon;
		const SearchAddon = window.SearchAddon?.SearchAddon || window.SearchAddon;

		let term = null;
		let ws = null;
		let fitAddon = null;
		let searchAddon = null;
		let resizeHandler = null;
		let serialConnected = false;

		function getWsUrl() {
			const proto = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
			return proto + '//' + window.location.host;
		}

		// setConnStatus / updateSerialButtons swap the `hidden` property
		// between the server-rendered state variants of the badge and the
		// connect / disconnect buttons — no class or innerHTML rebuilding.
		// The hidden ATTRIBUTE, not the utility class: preflight's
		// [hidden] { display: none !important } always beats the components'
		// own display utilities, while a `hidden` class does not.
		function setConnStatus(state) {
			for (const s of ['disconnected', 'connecting', 'connected']) {
				document.getElementById('conn-status-' + s).hidden = (s !== state);
			}
		}

		function updateSerialButtons(busy) {
			const connect = document.getElementById('btn-serial-connect');
			connect.hidden = serialConnected;
			connect.disabled = !!busy;
			document.getElementById('btn-serial-disconnect').hidden = !serialConnected;
		}

		// Raw input path for the virtual keyboard: write bytes to the serial
		// WebSocket exactly as xterm's AttachAddon would for typed keys.
		window.sendSerialInput = function(data) {
			if (ws && ws.readyState === WebSocket.OPEN) ws.send(data);
		};

		// ── Clipboard (shared with the BMC terminal drawer) ────────────────
		// Ctrl+C copies only while text is selected — with no selection it
		// still reaches the PTY as SIGINT. Ctrl+V pastes.
		//
		// The UI is normally served over plain http (the board's LAN address),
		// where navigator.clipboard does not exist. So: paste works by
		// returning false WITHOUT preventDefault — xterm then doesn't send
		// ^V (0x16) to the PTY, and the browser delivers a native paste event
		// to xterm's hidden textarea, which xterm inserts itself. Copy falls
		// back to a temp textarea + execCommand when the async API is missing.
		function copyTextToClipboard(text, refocus) {
			if (navigator.clipboard && window.isSecureContext) {
				navigator.clipboard.writeText(text).catch(() => execCopy(text, refocus));
			} else {
				execCopy(text, refocus);
			}
		}
		function execCopy(text, refocus) {
			const ta = document.createElement('textarea');
			ta.value = text;
			ta.style.position = 'fixed';
			ta.style.opacity = '0';
			document.body.appendChild(ta);
			ta.focus();
			ta.select();
			try { document.execCommand('copy'); } catch (e) {}
			document.body.removeChild(ta);
			if (refocus) refocus.focus();
		}
		// Returns xterm's attachCustomKeyEventHandler contract: false = xterm
		// must not process the key, true = handle as usual.
		window.handleTermClipboardKeys = function(t, e) {
			if (e.type !== 'keydown' || !e.ctrlKey || e.altKey || e.metaKey || e.shiftKey) return true;
			const key = e.key.toLowerCase();
			if (key === 'c' && t.hasSelection()) {
				copyTextToClipboard(t.getSelection(), t);
				// Clear so an immediate second Ctrl+C sends the interrupt.
				t.clearSelection();
				e.preventDefault();
				return false;
			}
			if (key === 'v') return false;
			return true;
		};

		window.connectSerial = function() {
			if (ws) disconnectSerial();

			term = new Terminal({
				allowProposedApi: true,
				cursorBlink: true,
				fontSize: 13,
				fontFamily: 'Menlo, Monaco, "Courier New", monospace',
			});
			fitAddon = new FitAddon();
			term.loadAddon(fitAddon);
			searchAddon = new SearchAddon();
			term.loadAddon(searchAddon);

			// Bind Ctrl+F to the search bar at the xterm level so the key is
			// swallowed while the terminal is focused - otherwise xterm would
			// forward ^F (0x06) to the PTY (readline forward-char / vim page
			// down) in addition to opening the find bar. Returning false stops
			// xterm from sending it; preventDefault stops the browser's own
			// find. The document keydown handler still covers Ctrl+F when focus
			// is outside the terminal.
			term.attachCustomKeyEventHandler((e) => {
				if (e.type === 'keydown' && e.ctrlKey && !e.altKey && !e.metaKey &&
				    (e.key === 'f' || e.key === 'F')) {
					e.preventDefault();
					openSearch();
					return false;
				}
				return handleTermClipboardKeys(term, e);
			});

			const el = document.getElementById('terminal');
			el.innerHTML = '';
			term.open(el);
			fitAddon.fit();

			ws = new WebSocket(getWsUrl() + '/api/vm/terminal');
			setConnStatus('connecting');
			updateSerialButtons(true);

			ws.onopen = () => {
				term.loadAddon(new AttachAddon(ws));
				serialConnected = true;
				setConnStatus('connected');
				updateSerialButtons();
			};
			ws.onclose = () => {
				serialConnected = false;
				setConnStatus('disconnected');
				updateSerialButtons();
			};
			ws.onerror = () => {
				serialConnected = false;
				setConnStatus('disconnected');
				updateSerialButtons();
			};

			resizeHandler = () => { if (fitAddon) fitAddon.fit(); };
			window.addEventListener('resize', resizeHandler);
		};

		// Refit against the current box. Exported because the console can be
		// hidden behind the HDMI tab, and xterm measures its grid from the
		// container: fitting while display:none yields a degenerate grid that
		// persists once the pane is shown again. The tab strip calls this when
		// the serial pane comes back to the front.
		window.fitTerminal = function() {
			if (fitAddon) fitAddon.fit();
		};

		window.disconnectSerial = function() {
			if (resizeHandler) { window.removeEventListener('resize', resizeHandler); resizeHandler = null; }
			if (ws && ws.readyState === WebSocket.OPEN) ws.close();
			ws = null;
			if (term) { term.dispose(); term = null; }
			fitAddon = null;
			searchAddon = null;
			closeSearch();
		};

		// ── Search ─────────────────────────────────────────────────────────
		let _searchOpen = false;
		window.toggleSearch = function() { _searchOpen ? closeSearch() : openSearch(); };
		// Search expands in place: the icon button and the input group are
		// siblings in the same button group, and opening swaps which one is
		// hidden. The `hidden` PROPERTY is what moves — the components set
		// their own display, so a utility class would lose to it.
		window.openSearch = function() {
			_searchOpen = true;
			document.getElementById('btn-search').hidden = true;
			document.getElementById('search-inputgroup').hidden = false;
			const input = document.getElementById('search-input');
			input.focus();
			input.select();
			// The controls can wrap to a second row once the input takes the
			// icon button's place, which changes the terminal's height.
			if (fitAddon) fitAddon.fit();
		};
		window.closeSearch = function() {
			_searchOpen = false;
			document.getElementById('search-inputgroup').hidden = true;
			document.getElementById('btn-search').hidden = false;
			document.getElementById('search-count').textContent = '';
			if (searchAddon) searchAddon.clearDecorations();
			if (fitAddon) fitAddon.fit();
		};
		// Case and regex are icon buttons rather than checkboxes, so their
		// state lives in aria-pressed: one value that assistive tech
		// announces and buildSearchOpts reads back.
		window.toggleSearchOption = function(id) {
			const el = document.getElementById(id);
			if (!el) return;
			const on = el.getAttribute('aria-pressed') !== 'true';
			el.setAttribute('aria-pressed', String(on));
			el.classList.toggle('bg-accent', on);
			el.classList.toggle('text-accent-foreground', on);
			onSearchInput();
		};
		function searchOptionOn(id) {
			const el = document.getElementById(id);
			return !!el && el.getAttribute('aria-pressed') === 'true';
		}
		window.onSearchInput = function() {
			const q = document.getElementById('search-input').value;
			if (!searchAddon || !q) {
				document.getElementById('search-count').textContent = '';
				if (searchAddon) searchAddon.clearDecorations();
				return;
			}
			searchAddon.findNext(q, { ...buildSearchOpts(), incremental: true });
		};
		window.findNext = function() {
			if (!searchAddon) return;
			const q = document.getElementById('search-input').value;
			if (q) searchAddon.findNext(q, buildSearchOpts());
		};
		window.findPrevious = function() {
			if (!searchAddon) return;
			const q = document.getElementById('search-input').value;
			if (q) searchAddon.findPrevious(q, buildSearchOpts());
		};
		function buildSearchOpts() {
			return {
				caseSensitive: searchOptionOn('search-case'),
				regex: searchOptionOn('search-regex'),
				wholeWord: false,
				decorations: {
					matchBackground: '#3b3b00',
					matchBorder: '#a3a300',
					matchOverviewRuler: '#a3a300',
					activeMatchBackground: '#fbbf24',
					activeMatchBorder: '#f59e0b',
					activeMatchColorOverviewRuler: '#f59e0b',
				},
			};
		}
		window.onSearchKeydown = function(e) {
			if (e.key === 'Enter') { e.preventDefault(); e.shiftKey ? findPrevious() : findNext(); }
			else if (e.key === 'Escape') { e.preventDefault(); closeSearch(); if (term) term.focus(); }
		};

		// ── Expand / Fullscreen ────────────────────────────────────────────
		window.toggleExpand = function() {
			const pane = document.getElementById('console-pane');
			const btn = document.getElementById('btn-expand');
			pane.classList.toggle('expanded');
			const isExpanded = pane.classList.contains('expanded');
			btn.classList.toggle('bg-accent', isExpanded);
			btn.title = isExpanded ? 'Collapse console' : 'Expand console';
			const header = document.querySelector('header');
			if (header) header.style.display = isExpanded ? 'none' : '';
			setTimeout(() => { if (fitAddon) fitAddon.fit(); }, 50);
		};
		window.toggleFullscreen = function() {
			const el = document.getElementById('console-pane');
			if (!document.fullscreenElement) {
				el.requestFullscreen().then(() => {
					el.classList.add('expanded');
					setTimeout(() => { if (fitAddon) fitAddon.fit(); }, 100);
				}).catch(() => {});
			} else {
				document.exitFullscreen();
			}
		};
		document.addEventListener('fullscreenchange', () => {
			if (!document.fullscreenElement) {
				document.getElementById('console-pane').classList.remove('expanded');
				const header = document.querySelector('header');
				if (header) header.style.display = '';
				const btn = document.getElementById('btn-expand');
				btn.title = 'Expand console';
				btn.classList.remove('bg-accent');
				setTimeout(() => { if (fitAddon) fitAddon.fit(); }, 50);
			}
		});

		document.addEventListener('keydown', (e) => {
			// The BMC terminal drawer owns its own keys while focused - don't
			// steal Ctrl+F / Escape from a shell the user is typing into.
			if (document.activeElement && document.activeElement.closest('#bmc-terminal-panel')) return;
			if (e.ctrlKey && e.key === 'f') { e.preventDefault(); openSearch(); return; }
			if (e.key === 'Escape') {
				if (_searchOpen) { closeSearch(); if (term) term.focus(); return; }
				const pane = document.getElementById('console-pane');
				if (pane.classList.contains('expanded') && !document.fullscreenElement) toggleExpand();
			}
		});

		// Auto-connect on page load.
		window.connectSerial();
	</script>
}
