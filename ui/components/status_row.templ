package components

import "github.com/pi-bmc/nanokvm-app/ui/components/item"

// statusRowClasses strips item.Item's card chrome down to the hairline
// label/value row shared by the overview sidebar cards and the settings
// dialog's network-status grid: no side padding (the parent card supplies
// it), a half-strength divider under each row, none after the last.
const statusRowClasses = "rounded-none border-0 border-b border-border/50 px-0 py-1 last:border-b-0"

// statusRow is one label / value readout row — muted label left, mono value
// right. One definition keeps the overview and settings readouts in the same
// rhythm by construction. Rows that need trailing content next to the value
// compose the item parts themselves with statusRowClasses + statusValue.
templ statusRow(label, value string) {
	@item.Item(item.Props{Size: item.SizeXs, Class: statusRowClasses}) {
		@item.Title(item.TitleProps{Class: "shrink-0 font-normal text-muted-foreground"}) {
			{ label }
		}
		@item.Content(item.ContentProps{Class: "items-end"}) {
			@statusValue(value)
		}
	}
}

// statusValue is the value cell of a statusRow; the em-dash placeholder
// shows while a fragment has not yet supplied the value.
templ statusValue(value string) {
	<span class="text-right font-mono break-all">
		if value != "" {
			{ value }
		} else {
			—
		}
	</span>
}
