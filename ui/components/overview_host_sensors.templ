package components

import (
	"github.com/pi-bmc/nanokvm-app/ui/components/badge"
	"github.com/pi-bmc/nanokvm-app/ui/components/card"
)

// overviewHostSensorsCard is what the managed host reports about itself: SoC
// temperature, active cooling, and the firmware's power-health word.
//
// Distinct from the Resources card above it, which is the BMC's own processor
// and memory. Two machines are involved and an operator reading a temperature
// needs to know whose it is, so each card names its subject in its description
// rather than relying on the reader to infer it from the section order.
//
// Lazy and polled like its neighbour — see overviewResourcesCard for why the
// drawer's live cards do both.
templ overviewHostSensorsCard() {
	@card.Card(card.Props{Class: overviewCardClass}) {
		@card.Header(card.HeaderProps{Class: "gap-1"}) {
			@card.Title(card.TitleProps{Class: SectionLabelClass}) {
				Host Sensors
			}
			@card.Description(card.DescriptionProps{Class: "text-xs"}) {
				Temperature and cooling, reported by the host's secure firmware.
			}
		}
		<div
			class="contents"
			hx-get="/ui/overview/host-sensors"
			hx-trigger="overview-opened from:body, every 10s [isOverviewOpen()]"
		>
			@OverviewHostSensorsBody(OverviewHostSensors{})
		</div>
	}
}

// OverviewHostSensorsBody renders the traces, or says why there are none.
templ OverviewHostSensorsBody(m OverviewHostSensors) {
	@card.Content() {
		if !m.Available {
			<p class="text-xs text-muted-foreground">
				This board has no sensor channel to the host.
			</p>
		} else if !m.Sampling {
			<p class="text-xs text-muted-foreground">
				Waiting for the host. Readings appear once it boots past its firmware.
			</p>
		} else {
			<div class="flex flex-col gap-3">
				if !m.Reporting {
					// The trace below is real but frozen. Saying so is the
					// whole point: a die temperature for a machine that is off
					// is the one reading this card must never imply.
					<p class="text-xs text-muted-foreground">
						The host has stopped reporting — the last readings are shown.
					</p>
				}
				for _, s := range m.Series() {
					@sparkGraph(s)
				}
				@hostThrottleBadges(m)
			</div>
		}
	}
	@card.Footer(card.FooterProps{Class: "text-xs text-muted-foreground"}) {
		Pushed from the host over I2C · also at
		<a href="/redfish/v1/Chassis/1/Sensors/SoCTemp" target="_blank" rel="noopener noreferrer" class="ml-1 underline underline-offset-4 hover:text-foreground">Redfish</a>.
	}
}

// hostThrottleBadges is the firmware's GET_THROTTLED word.
//
// Badges rather than a trace: these are conditions, not quantities, and a
// square wave between 0 and 1 in a 32px box is a worse way to read "the PMIC
// is browning out" than the words are. Only the live flags appear — the
// latched-since-boot halves are in Redfish for anyone who needs them, and as a
// badge they would appear at the first brownout and never clear.
templ hostThrottleBadges(m OverviewHostSensors) {
	if !m.ThrottleKnown {
		<p class="text-xs text-muted-foreground">
			Power health not reported by this firmware.
		</p>
	} else if len(m.Throttles) == 0 {
		@badge.Badge(badge.Props{
			Variant: badge.VariantSecondary,
			Class:   "bg-green-500/15 text-green-500 text-xs",
		}) {
			Power and thermals nominal
		}
	} else {
		<div class="flex flex-wrap gap-1">
			for _, t := range m.Throttles {
				@badge.Badge(badge.Props{
					Variant: badge.VariantSecondary,
					Class:   "bg-destructive/15 text-destructive text-xs",
				}) {
					{ t }
				}
			}
		</div>
	}
}
