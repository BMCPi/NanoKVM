package components

import (
	"github.com/pi-bmc/nanokvm-app/pkg/power"
	"github.com/pi-bmc/nanokvm-app/ui/components/button"
	"github.com/pi-bmc/nanokvm-app/ui/components/dropdownmenu"
	"github.com/pi-bmc/nanokvm-app/ui/components/icon"
	"github.com/pi-bmc/nanokvm-app/ui/utils"
)

// initialPowerState reads the host power state at render time so the navbar
// pill paints correctly on first load; the SSE stream keeps it fresh after.
// known is false when the controller cannot read the state (e.g. dev host),
// in which case the pill falls back to the neutral "Checking…" look until
// the stream delivers.
func initialPowerState() (on bool, known bool) {
	s, err := power.GetController().State()
	return s, err == nil
}

// PowerMenu is the navbar power-state pill and the dropdown holding power
// actions + boot-device override. Polled by the inline script below; clicks
// on items dispatch /api/vm/gpio.
templ PowerMenu() {
	@dropdownmenu.DropdownMenu() {
		@button.Button(button.Props{
			Variant: button.VariantGhost,
			Size:    button.SizeSm,
			Attributes: utils.MergeAttributes(
				dropdownmenu.Trigger(ctx),
				templ.Attributes{"aria-label": "Power menu"},
			),
		}) {
			{{ pwrOn, pwrKnown := initialPowerState() }}
			if pwrKnown && pwrOn {
				<span id="power-dot" class="inline-block size-2 rounded-full bg-green-500 shrink-0"></span>
				<span id="power-text" class="hidden sm:inline">Power On</span>
			} else if pwrKnown {
				<span id="power-dot" class="inline-block size-2 rounded-full bg-destructive shrink-0"></span>
				<span id="power-text" class="hidden sm:inline">Power Off</span>
			} else {
				<span id="power-dot" class="inline-block size-2 rounded-full bg-muted-foreground shrink-0"></span>
				<span id="power-text" class="hidden sm:inline">Checking…</span>
			}
			@icon.ChevronDown()
		}
		@dropdownmenu.Content(dropdownmenu.ContentProps{Class: "w-72 panel-fit"}) {
			<div class="p-2 space-y-2">
				// Power actions: 2×2 compact grid
				<div>
					<p class="px-1 pb-1 text-[0.6875rem] font-semibold uppercase tracking-wide text-muted-foreground">Power</p>
					<div class="grid grid-cols-2 gap-1">
						@powerGridBtn("powerAction('on')", "", icon.Power, "Power On")
						@powerGridBtn("powerAction('off')", "", icon.PowerOff, "Power Off")
						@powerGridBtn("powerAction('reset')", "", icon.RefreshCw, "Reset")
						@powerGridBtn("confirmPowerAction('forceoff', 'Force power off?', 'The host loses power immediately without a clean shutdown.')", "text-destructive hover:text-destructive", icon.CircleX, "Force Off")
						@powerGridBtn("confirmPowerAction('rpiboot', 'Enter USB recovery mode?', 'Forces the host into rpiboot (USB recovery). A running host is powered off first.')", "col-span-2", icon.Usb, "Recovery (rpiboot)")
					</div>
				</div>
				<div class="h-px bg-border"></div>
				// Boot override: two selects side-by-side + apply/clear in one row.
				// Native <select> elements (like the Virtual Media ISO picker):
				// the shadcn-templ Select portals its popup to <body>, and the
				// dropdown menu treats pointerdowns there as outside clicks, so
				// a composed Select would close the menu on first use.
				<div class="space-y-1.5">
					<p class="px-1 text-[0.6875rem] font-semibold uppercase tracking-wide text-muted-foreground">Boot Override</p>
					<div class="grid grid-cols-2 gap-1">
						@bootDeviceSelect()
						@bootPersistSelect()
					</div>
					<div class="flex gap-1">
						@button.Button(button.Props{
							Size:       button.SizeSm,
							Class:      "flex-1",
							Attributes: templ.Attributes{"onclick": "applyBootOverride()"},
						}) {
							Apply
						}
						@button.Button(button.Props{
							Variant:    button.VariantDestructive,
							Size:       button.SizeSm,
							Attributes: templ.Attributes{"onclick": "clearBootOverride()"},
						}) {
							Clear
						}
					</div>
				</div>
			</div>
		}
	}
	@powerMenuScript()
}

// powerGridBtn renders a compact icon+label button for the 2×2 power grid.
templ powerGridBtn(onclick, class string, ico func(...icon.Props) templ.Component, label string) {
	@button.Button(button.Props{
		Variant:    button.VariantOutline,
		Size:       button.SizeSm,
		Class:      "w-full justify-start gap-2 " + class,
		Attributes: templ.Attributes{"onclick": onclick},
	}) {
		@ico()
		<span>{ label }</span>
	}
}

// bootDeviceSelect drives the Redfish boot device override.
templ bootDeviceSelect() {
	@NativeSelect("boot-device", "w-full min-w-0 px-2") {
		<option value="None" selected>Default</option>
		<option value="Pxe">PXE / Network</option>
		<option value="Hdd">HDD / SD / NVMe</option>
		<option value="Cd">USB / CD-ROM</option>
		<option value="BiosSetup">BIOS Setup</option>
	}
}

// bootPersistSelect chooses Once vs Continuous for the boot override.
templ bootPersistSelect() {
	@NativeSelect("boot-persist", "w-full min-w-0 px-2") {
		<option value="Once" selected>Once (default)</option>
		<option value="Continuous">Continuous</option>
	}
}

// NativeSelect renders a plain <select> styled to match the Input component.
// Used where the composed Select can't go — inside dropdown menus, whose
// outside-click dismiss would fire on the Select's body-portaled popup.
templ NativeSelect(id string, class string) {
	<select id={ id } name={ id } class={ "h-8 rounded-md border border-input bg-transparent text-sm dark:bg-input/30", class }>
		{ children... }
	</select>
}

templ powerMenuScript() {
	<script>
		function renderPower(on) {
			const dot = document.getElementById('power-dot');
			dot.className = 'inline-block size-2 rounded-full ' + (on ? 'bg-green-500' : 'bg-destructive');
			const txt = document.getElementById('power-text');
			txt.textContent = on ? 'Power On' : 'Power Off';
			txt.className = 'hidden sm:inline';
		}

		// The server pushes a `power` event on every GPIO transition, so there is
		// nothing to poll. EventSource reconnects on its own after a drop; the
		// stream re-sends the current state on connect, so a reconnect resyncs.
		// Auth rides the nano-kvm-token cookie, which EventSource sends for us.
		const powerEvents = new EventSource('/api/vm/gpio/events');
		powerEvents.addEventListener('power', (e) => {
			try {
				renderPower(JSON.parse(e.data).pwr);
			} catch(err) { console.error(err); }
		});
		powerEvents.onerror = () => {
			// Leave the last known state on screen while EventSource retries.
			console.debug('power stream interrupted, reconnecting');
		};

		async function powerAction(action) {
			try {
				await fetch('/api/vm/gpio', {
					method: 'POST', headers: getAuthHeaders(),
					body: JSON.stringify({action}),
				});
			} catch(e) { console.error(e); }
			// No refresh needed — the resulting LED transition arrives on the stream.
		}

		async function confirmPowerAction(action, title, description) {
			if (await uiConfirm({ title, description, destructive: true })) powerAction(action);
		}

		async function applyBootOverride() {
			const device = document.getElementById('boot-device').value || 'None';
			const persist = document.getElementById('boot-persist').value || 'Once';
			try {
				const r = await fetch('/redfish/v1/Systems/1', {
					method: 'PATCH', headers: getAuthHeaders(),
					body: JSON.stringify({ Boot: { BootSourceOverrideTarget: device, BootSourceOverrideEnabled: persist } })
				});
				if (!r.ok) throw new Error(r.statusText);
				const b = (await r.json()).Boot;
				tui.toast.add({ type: 'success', title: 'Boot override set',
					description: b ? `${b.BootSourceOverrideTarget} (${b.BootSourceOverrideEnabled})` : undefined });
			} catch(e) {
				tui.toast.add({ type: 'error', title: 'Boot override failed' });
			}
			if (typeof loadFirmwareInfo === 'function') loadFirmwareInfo();
		}

		async function clearBootOverride() {
			try {
				const r = await fetch('/redfish/v1/Systems/1', {
					method: 'PATCH', headers: getAuthHeaders(),
					body: JSON.stringify({ Boot: { BootSourceOverrideTarget: 'None', BootSourceOverrideEnabled: 'Disabled' } })
				});
				if (!r.ok) throw new Error(r.statusText);
				tui.toast.add({ type: 'success', title: 'Boot override cleared' });
			} catch(e) {
				tui.toast.add({ type: 'error', title: 'Clearing boot override failed' });
			}
			if (typeof loadFirmwareInfo === 'function') loadFirmwareInfo();
		}
	</script>
}
