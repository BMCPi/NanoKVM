package components

import (
	"context"

	"github.com/pi-bmc/nanokvm-app/pkg/config"
	"github.com/pi-bmc/nanokvm-app/pkg/deps"
	"github.com/pi-bmc/nanokvm-app/pkg/device/power"
	"github.com/pi-bmc/nanokvm-app/ui/components/button"
	"github.com/pi-bmc/nanokvm-app/ui/components/buttongroup"
	"github.com/pi-bmc/nanokvm-app/ui/components/dropdownmenu"
	"github.com/pi-bmc/nanokvm-app/ui/components/icon"
	selectcomp "github.com/pi-bmc/nanokvm-app/ui/components/select"
	"github.com/pi-bmc/nanokvm-app/ui/utils"
)

// Fixed ids: powerToggleID is powerActionGroup's hx-target for the SSE
// toggle swap, and the boot-override region is an htmx swap target too.
const (
	powerMenuTriggerID  = "power-menu-trigger"
	powerToggleID       = "power-toggle"
	powerBootOverrideID = "power-boot-override"
	bootApplyID         = "boot-apply"
	bootModeLabelID     = "boot-mode-label"
)

// initialPowerState reads the host power state at render time so the navbar
// pill and the power toggle paint correctly on first load; the SSE stream
// keeps both fresh after. known is false when the controller cannot read the
// state (e.g. dev host), in which case the pill falls back to the neutral
// "Checking…" look until the stream delivers.
func initialPowerState(ctx context.Context, ctrl *power.Controller) (on bool, known bool) {
	s, err := ctrl.State(ctx)
	return s, err == nil
}

// resetIsLine reports whether the Reset control's action will pulse the
// dedicated GPIO reset line rather than force-off+repower — i.e. whether
// (*power.Controller).Restart will dispatch to the reset line for the
// board's wiring and the operator's power.reset policy. Mirrors Restart's
// own dispatch (see its doc comment): "line" and "auto" use the line when
// wired, "cycle" never does. When false the control is disabled (see
// powerActionGroup): Force reset is the grid's force-off+repower.
func resetIsLine(ctrl *power.Controller, policy string) bool {
	return ctrl.CanResetLine() && policy != config.PowerResetCycle
}

// resetUnavailableTitle is the disabled Reset control's tooltip: why it
// cannot pulse the line, and which cell does the job instead.
const resetUnavailableTitle = "The reset line is not wired, or power.reset is set to cycle. Use Force reset to power-cycle the host."

// resetControlAttrs is the Reset cell's extra attributes: the reason it is
// disabled when it is, nothing when it is live.
func resetControlAttrs(resetLine bool) templ.Attributes {
	if resetLine {
		return nil
	}
	return templ.Attributes{"title": resetUnavailableTitle}
}

// destructiveActionClass is the tone shared by the two forced actions, which
// both cut a possibly running host's power.
const destructiveActionClass = "text-destructive hover:text-destructive"

// PowerMenu is the navbar power-state pill and the dropdown holding power
// actions + boot-device override. Actions are htmx posts to /ui/power/…;
// the pill and the toggle are both fed by GET /ui/power/events (see
// ui/fragments_power_events.go) via htmx's SSE extension — sse-swap on each,
// not a script re-deriving their markup from a JSON payload.
//
// The pill and the toggle each open their own SSE connection to the same
// stream rather than sharing one from a common wrapper here, because they
// don't share a live ancestor to hang it on: dropdownmenu.Content (holding
// the toggle) is moved to <body> as one unit by dropdownmenu.js once the
// page loads, which detaches it from anything outside itself, including
// PowerMenu's own root. See powerActionGroup for the toggle's half.
templ PowerMenu() {
	// Read once at the top: the pill and the power toggle must agree, and
	// both are painted from this single answer.
	{{ pwrOn, pwrKnown := initialPowerState(ctx, deps.FromContext(ctx).Power) }}
	// Also read once: whether the Reset control is enabled depends on wiring
	// and the operator's power.reset policy, neither of which changes over
	// the dropdown's lifetime, so there is no SSE fragment for it (contrast
	// PowerPill/PowerToggleBtn, which do change on every transition).
	{{ resetLine := resetIsLine(deps.FromContext(ctx).Power, deps.FromContext(ctx).Config.Power.Reset) }}
	@dropdownmenu.DropdownMenu() {
		@button.Button(button.Props{
			ID:      powerMenuTriggerID,
			Variant: button.VariantGhost,
			Size:    button.SizeSm,
			Attributes: utils.MergeAttributes(
				dropdownmenu.Trigger(ctx),
				templ.Attributes{"aria-label": "Power menu"},
			),
		}) {
			// The trigger is never portaled, so it can own a self-contained
			// SSE scope: sse-connect and sse-swap on the same element is a
			// supported htmx-ext-sse pattern. class="contents" keeps the
			// wrapper out of the button's flex layout, so the dot/label pair
			// still sit directly in its flex row sharing the button's own
			// gap, matching the pre-SSE markup pixel for pixel.
			<span class="contents" hx-ext="sse" sse-connect="/ui/power/events" sse-swap="powerpill">
				@PowerPill(pwrOn, pwrKnown)
			</span>
			@icon.ChevronDown()
		}
		// Wide enough for two labelled power cells side by side (the grid's
		// widest row is "Force Off" beside "Force reset", icons included)
		// and for the boot-override row's welded group. Labels stay rather
		// than collapsing to icons because the destructive ones have to be
		// unambiguous. panel-fit caps the height only, so the viewport cap
		// here is what keeps the panel on screen on a phone.
		@dropdownmenu.Content(dropdownmenu.ContentProps{Class: "w-[26rem] max-w-[calc(100vw-1.5rem)] panel-fit"}) {
			// Spacing follows the settings dialog's rhythm on the 4px grid, at
			// popup density: p-3 panel, space-y-3 sections, space-y-2 / gap-2
			// within a section, and the field.Legend header type (text-xs
			// font-semibold uppercase) — no off-scale sizes or stray indents.
			<div class="p-3 space-y-3">
				<div>
					<p class={ SectionLabelClass, "mb-2" }>Power</p>
					@powerActionGroup(pwrOn && pwrKnown, resetLine)
				</div>
				<div class="h-px bg-border"></div>
				// The staged override is BMC state that can change from the
				// overview card, the Redfish API or another session, so it is
				// fetched when the menu opens rather than baked in at page
				// render — and re-fetched on fw-changed, which the shared
				// boot-override handler fires after every apply.
				<div
					id={ powerBootOverrideID }
					hx-get="/ui/power/boot-override"
					hx-trigger={ "click from:#" + powerMenuTriggerID + ", fw-changed from:body" }
					hx-swap="innerHTML"
				>
					@PowerBootOverride(OverviewBootOverride{})
				</div>
			</div>
		}
	}
	@powerMenuScript()
}

// PowerPill is the navbar power-state indicator: the icon + label pair shown
// on the menu trigger. Exported so the SSE stream (ui/fragments/power_events.go)
// can render the same markup into a swap fragment instead of the JavaScript
// side re-deriving the colour and the label text from a JSON payload.
//
// Tone and label come from two helpers rather than three near-identical
// branches. Branches paired the colour and the words by copy-paste in three
// places, which is the shape that let the toggle's label drift from its
// hx-post path; now a fourth state touches each concern exactly once.
//
// This is deliberately ONE fragment, updated by a single sse-swap on the
// wrapper in PowerMenu. Splitting the icon and the label into separate swap
// targets would let them tear — the icon flipping green while the words still
// read "Power Off" — and a self-contradicting power indicator is worse than a
// marginally larger fragment.
templ PowerPill(on, known bool) {
	@icon.Circle(icon.Props{Class: "size-2 shrink-0 " + powerTone(on, known)})
	<span id="power-text" class="hidden sm:inline">{ powerLabel(on, known) }</span>
}

// powerTone is the indicator's colour for each state.
//
// fill AND stroke, not text: the icon is a lucide outline glyph whose svg
// carries fill="none" stroke="currentColor" as presentation attributes.
// Those lose to CSS, so the utilities override both — filling the circle so
// it reads as the solid status dot it replaced rather than a ring.
//
// Unknown is deliberately muted rather than red: before the stream delivers,
// the host's state is not known to be off, and showing it as off invites
// power-cycling a running host.
func powerTone(on, known bool) string {
	switch {
	case !known:
		return "fill-muted-foreground stroke-muted-foreground"
	case on:
		return "fill-green-500 stroke-green-500"
	default:
		return "fill-destructive stroke-destructive"
	}
}

// powerLabel is the words beside the icon. It always renders something: colour
// alone would carry the state otherwise, which fails WCAG 1.4.1 and lands on
// red/green, the most common colour-blind pair.
func powerLabel(on, known bool) string {
	switch {
	case !known:
		return "Checking…"
	case on:
		return "Power On"
	default:
		return "Power Off"
	}
}

// powerActionGroup is the four power controls in a two-column grid — power
// on the left, reset on the right; the plain action on top, the forced one
// beneath it, so Force reset is the last cell:
//
//	[ Power On/Off ]  [ Reset       ]
//	[ Force Off    ]  [ Force reset ]
//
// Power on and power off are one button rather than two, because they are not
// two things an operator chooses between: exactly one of them is meaningful
// at any moment, and the other would either be a no-op or a mistake. Which
// one it is comes from the same source as the navbar pill — the GPIO power
// LED — so the button and the pill can never disagree.
//
// Reset and Force reset are two buttons because they are two things (the
// board-agnostic design's §1 table). Reset follows the operator's power.reset
// policy and pulses the dedicated line — Redfish ForceRestart, IPMI hard
// reset. Force reset is the unconditional force-off+repower — Redfish
// PowerCycle, IPMI power cycle — so it is destructive to a running host and
// confirmed like Force Off. When wiring or policy would make Reset
// force-off+repower as well, it is disabled with the reason as its title
// rather than relabelled: a second button that cuts the host's power under a
// different name is a trap, and a button reading "Reset" must never do that
// silently.
templ powerActionGroup(on bool, resetLine bool) {
	// hx-ext/sse-connect live on the grid itself, not on PowerMenu: this
	// whole fragment is portaled to <body> in one piece (see PowerMenu's
	// doc comment), so the connection has to originate from inside the
	// portaled subtree to still be reachable afterward.
	//
	// sse-swap/hx-target/hx-swap redirect the update at #power-toggle
	// instead of letting it land on the grid: sse-swap defaults to
	// innerHTML, which would replace all four cells with the toggle alone.
	// hx-swap=outerHTML replaces the toggle wholesale, in its own cell.
	<div
		class="grid grid-cols-2 gap-2"
		hx-ext="sse"
		sse-connect="/ui/power/events"
		sse-swap="powertoggle"
		hx-target={ "#" + powerToggleID }
		hx-swap="outerHTML"
	>
		@PowerToggleBtn(on)
		@powerActionBtn(powerActionProps{
			Action:   "reset",
			Label:    "Reset",
			Disabled: !resetLine,
			Attrs:    resetControlAttrs(resetLine),
		}) {
			@icon.RefreshCw()
		}
		@powerActionBtn(powerActionProps{
			Action: "forceoff",
			Label:  "Force Off",
			Class:  destructiveActionClass,
			Attrs: templ.Attributes{
				"hx-confirm":               "The host loses power immediately without a clean shutdown.",
				"data-confirm-title":       "Force power off?",
				"data-confirm-label":       "Force Off",
				"data-confirm-destructive": true,
			},
		}) {
			@icon.CircleX()
		}
		@powerActionBtn(powerActionProps{
			Action: "forcereset",
			Label:  "Force reset",
			Class:  destructiveActionClass,
			Attrs: templ.Attributes{
				"hx-confirm":               "The host loses power immediately without a clean shutdown, then powers back on.",
				"data-confirm-title":       "Force reset?",
				"data-confirm-label":       "Force reset",
				"data-confirm-destructive": true,
			},
		}) {
			@icon.RotateCcw()
		}
	</div>
}

// PowerToggleBtn is the on/off half of the group. Exported so the SSE stream
// (ui/fragments_power_events.go) can render it into a swap fragment — the
// same markup the full page paints, instead of the client rewriting hx-post
// and the icon `hidden` flags after the fact (see powerTogglePath/
// powerToggleLabel history in the htmx-sse migration).
//
// Both icons are rendered and one is hidden, rather than the script swapping
// SVG markup: the icons are inline <svg> the server already knows how to
// draw, and flipping a `hidden` property is something a five-line stream
// handler can do correctly. The `hidden` ATTRIBUTE is load-bearing —
// preflight's `[hidden] { display: none !important }` beats the icon's own
// display, which a utility class would lose to.
templ PowerToggleBtn(on bool) {
	@button.Button(button.Props{
		ID:      powerToggleID,
		Variant: button.VariantOutline,
		Size:    button.SizeSm,
		Class:   "w-full gap-2",
		Attributes: templ.Attributes{
			"hx-post":         powerTogglePath(on),
			"hx-swap":         "none",
			"hx-disabled-elt": "this",
		},
	}) {
		<span
			id="power-toggle-icon-on"
			class="contents"
			if on {
				hidden
			}
		>
			@icon.Power()
		</span>
		<span
			id="power-toggle-icon-off"
			class="contents"
			if !on {
				hidden
			}
		>
			@icon.PowerOff()
		</span>
		<span id="power-toggle-label">{ powerToggleLabel(on) }</span>
	}
}

// powerTogglePath is the action the toggle posts: the one that changes the
// state it is currently in.
func powerTogglePath(on bool) string {
	if on {
		return "/ui/power/off"
	}
	return "/ui/power/on"
}

func powerToggleLabel(on bool) string {
	if on {
		return "Power Off"
	}
	return "Power On"
}

// powerActionProps is one cell of the power grid.
type powerActionProps struct {
	Action   string // posts to /ui/power/<Action>
	Label    string
	Class    string // tone only; the cell's layout classes are fixed
	Disabled bool
	Attrs    templ.Attributes // hx-confirm et al. for destructive actions, title for a disabled one
}

// powerActionBtn renders one power action cell.
templ powerActionBtn(p powerActionProps) {
	@button.Button(button.Props{
		Variant:  button.VariantOutline,
		Size:     button.SizeSm,
		Class:    "w-full gap-2 " + p.Class,
		Disabled: p.Disabled,
		Attributes: utils.MergeAttributes(templ.Attributes{
			"hx-post":         "/ui/power/" + p.Action,
			"hx-swap":         "none",
			"hx-disabled-elt": "this",
		}, p.Attrs),
	}) {
		{ children... }
		<span>{ p.Label }</span>
	}
}

// PowerBootOverride is the menu's boot-override section, served as a fragment
// so it reflects what is actually staged at the moment the menu opens.
//
// The controls are one button group of three welded segments — apply, the
// persistence to apply with, and clear. The middle segment is a split button:
// its label shows the persistence and both halves open the same menu, so the
// chevron is a real affordance rather than decoration.
//
// mode reaches the handler from whichever submit button was clicked, which is
// why Apply carries it as its own value and the dropdown rewrites that value
// rather than maintaining a separate hidden field. One field, one source: a
// hidden input plus a named submit button would send mode twice and leave the
// handler picking.
templ PowerBootOverride(m OverviewBootOverride) {
	<form class="space-y-2" hx-post="/ui/overview/boot-override" hx-swap="none">
		<p class={ SectionLabelClass }>Boot Override</p>
		@bootDeviceSelect(m.SelectValue())
		@dropdownmenu.DropdownMenu() {
			@buttongroup.ButtonGroup(buttongroup.Props{Class: "w-full"}) {
				@buttongroup.ButtonGroup() {
					@button.Button(button.Props{
						ID:    bootApplyID,
						Size:  button.SizeSm,
						Type:  button.TypeSubmit,
						Class: "flex-1",
						Attributes: templ.Attributes{
							"name":  "mode",
							"value": m.ModeValue(),
						},
					}) {
						Apply
					}
				}
				@buttongroup.ButtonGroup() {
					@button.Button(button.Props{
						ID:      bootModeLabelID,
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
						Attributes: utils.MergeAttributes(
							dropdownmenu.Trigger(ctx),
							templ.Attributes{"aria-label": "Boot override persistence"},
						),
					}) {
						{ m.ModeLabel() }
					}
					@buttongroup.Separator()
					@button.Button(button.Props{
						Variant: button.VariantOutline,
						Size:    button.SizeIcon,
						Class:   "size-8",
						Attributes: utils.MergeAttributes(
							dropdownmenu.Trigger(ctx),
							templ.Attributes{"aria-label": "Choose boot override persistence"},
						),
					}) {
						@icon.ChevronDown()
					}
				}
				@buttongroup.ButtonGroup() {
					@button.Button(button.Props{
						Variant: button.VariantGhost,
						Size:    button.SizeSm,
						Type:    button.TypeSubmit,
						Attributes: templ.Attributes{
							"name":  "mode",
							"value": "clear",
						},
					}) {
						Clear
					}
				}
			}
			// Outside the groups: Content renders inline until the script
			// portals it to <body>, and a popup counted as a group child
			// would take the welding rules meant for buttons.
			@dropdownmenu.Content(dropdownmenu.ContentProps{Class: "w-44"}) {
				@dropdownmenu.Item(dropdownmenu.ItemProps{
					Attributes: templ.Attributes{"onclick": "setBootMode('once','Once')"},
				}) {
					Once
				}
				@dropdownmenu.Item(dropdownmenu.ItemProps{
					Attributes: templ.Attributes{"onclick": "setBootMode('continuous','Continuous')"},
				}) {
					Continuous
				}
			}
		}
	</form>
}

// bootDeviceSelect picks the boot-override target. Sole staging control now
// that the Server Overview's Boot Override card is gone; the target list is
// the Redfish BootSource vocabulary api/redfish/inventory.go accepts.
//
// The Select portals its popup to <body>, which used to make this a plain
// <select>: the menu read a press on a portaled option as an outside click and
// dismissed itself. The menu now recognises a Select popup as its own (see
// dropdownmenu.js), so the composed control works here.
templ bootDeviceSelect(value string) {
	@selectcomp.Select(selectcomp.Props{ID: "boot-device", Name: "boot-override", Value: value}) {
		@selectcomp.Trigger(selectcomp.TriggerProps{Class: "h-8 w-full min-w-0"}) {
			@selectcomp.Value(selectcomp.ValueProps{Placeholder: "None (default)"})
		}
		@selectcomp.Content() {
			@selectcomp.Item(selectcomp.ItemProps{Value: "None"}) {
				None (default)
			}
			@selectcomp.Item(selectcomp.ItemProps{Value: "Pxe"}) {
				PXE (network)
			}
			@selectcomp.Item(selectcomp.ItemProps{Value: "Hdd"}) {
				HDD / MMC / NVMe
			}
			@selectcomp.Item(selectcomp.ItemProps{Value: "Cd"}) {
				CD / USB
			}
			@selectcomp.Item(selectcomp.ItemProps{Value: "BiosSetup"}) {
				BIOS Setup
			}
			@selectcomp.Item(selectcomp.ItemProps{Value: "UefiHttp"}) {
				UEFI HTTP Boot
			}
		}
	}
}

// powerMenuScript hosts setBootMode — the pill and the toggle are now driven
// entirely by htmx's SSE extension (see PowerMenu's doc comment), so this is
// what's left.
//
// setBootMode lives here rather than in the boot-override fragment because
// that fragment is swapped by htmx on every open; a handler defined inside
// it would be redefined on each swap, and any listener bound to the old copy
// lost.
templ powerMenuScript() {
	<script>
		window.setBootMode = function (mode, label) {
			const apply = document.getElementById('boot-apply');
			if (apply) apply.value = mode;
			const shown = document.getElementById('boot-mode-label');
			if (shown) shown.textContent = label;
		};
	</script>
}
