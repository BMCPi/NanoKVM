package inputgroup

import (
	"github.com/pi-bmc/nanokvm-app/ui/components/button"
	"github.com/pi-bmc/nanokvm-app/ui/components/input"
	"github.com/pi-bmc/nanokvm-app/ui/components/textarea"
	"github.com/pi-bmc/nanokvm-app/ui/utils"
)

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type Align string

const (
	AlignInlineStart Align = "inline-start"
	AlignInlineEnd   Align = "inline-end"
	AlignBlockStart  Align = "block-start"
	AlignBlockEnd    Align = "block-end"
)

type ButtonSize string

const (
	ButtonSizeXs     ButtonSize = "xs"
	ButtonSizeSm     ButtonSize = "sm"
	ButtonSizeIconXs ButtonSize = "icon-xs"
	ButtonSizeIconSm ButtonSize = "icon-sm"
)

type AddonProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Align      Align
}

type InputProps struct {
	ID          string
	Class       string
	Attributes  templ.Attributes
	Type        string
	Name        string
	Value       string
	Placeholder string
	Disabled    bool
}

type TextareaProps struct {
	ID          string
	Class       string
	Attributes  templ.Attributes
	Name        string
	Value       string
	Placeholder string
	Disabled    bool
	Rows        int
}

type ButtonProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Type       button.Type
	Variant    button.Variant
	Size       ButtonSize
	Disabled   bool
}

type TextProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

templ InputGroup(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		role="group"
		data-slot="input-group"
		class={ utils.CN("border-transparent border-b-input bg-transparent has-[[data-slot=input-group-control]:focus-visible]:border-b-ring has-[[data-slot][aria-invalid=true]]:border-b-destructive dark:has-[[data-slot][aria-invalid=true]]:border-b-destructive/50 h-10 rounded-none border transition-[color,border-color] in-data-[slot=combobox-content]:focus-within:border-inherit in-data-[slot=combobox-content]:focus-within:ring-0 has-data-[align=block-end]:rounded-none has-data-[align=block-start]:rounded-none has-[textarea]:rounded-none has-[>[data-align=block-end]]:h-auto has-[>[data-align=block-end]]:flex-col has-[>[data-align=block-start]]:h-auto has-[>[data-align=block-start]]:flex-col has-[>[data-align=block-end]]:[&>input]:pt-3 has-[>[data-align=block-start]]:[&>input]:pb-3 group/input-group relative flex w-full min-w-0 items-center outline-none has-[>textarea]:h-auto", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// Input wraps the base Input component with the input-group control override,
// exactly like shadcn's InputGroupInput wraps <Input/>. All base sizing
// (h-8, w-full, px-2.5, …) comes from input.Input — no local re-styling.
templ Input(props ...InputProps) {
	{{ var p InputProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{
		attrs := templ.Attributes{"data-slot": "input-group-control"}
		for k, v := range p.Attributes {
			attrs[k] = v
		}
	}}
	@input.Input(input.Props{
		ID:          p.ID,
		Type:        p.Type,
		Name:        p.Name,
		Value:       p.Value,
		Placeholder: p.Placeholder,
		Disabled:    p.Disabled,
		Class:       utils.CN("border-0 bg-transparent ring-0 focus-visible:ring-0 aria-invalid:ring-0 dark:bg-transparent group-has-[>[data-align=inline-start]]/input-group:pl-2 group-has-[>[data-align=inline-end]]/input-group:pr-2 flex-1", p.Class),
		Attributes:  attrs,
	})
}

// Textarea wraps the base Textarea component with the input-group control
// override, exactly like shadcn's InputGroupTextarea wraps <Textarea/>.
templ Textarea(props ...TextareaProps) {
	{{ var p TextareaProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{
		attrs := templ.Attributes{"data-slot": "input-group-control"}
		for k, v := range p.Attributes {
			attrs[k] = v
		}
	}}
	@textarea.Textarea(textarea.Props{
		ID:          p.ID,
		Name:        p.Name,
		Value:       p.Value,
		Placeholder: p.Placeholder,
		Rows:        p.Rows,
		Disabled:    p.Disabled,
		Class:       utils.CN("border-0 bg-transparent py-2.5 ring-0 focus-visible:ring-0 aria-invalid:ring-0 dark:bg-transparent flex-1 resize-none", p.Class),
		Attributes:  attrs,
	})
}

templ Addon(props ...AddonProps) {
	{{ var p AddonProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Align == "" {
		{{ p.Align = AlignInlineStart }}
	}
	{{
		// 1:1 the inputGroupAddonVariants cva from base/ui/input-group.tsx.
		align := "order-first"
		switch p.Align {
		case AlignInlineEnd:
			align = "order-last"
		case AlignBlockStart:
			align = "pt-3 group-has-[>input]/input-group:pt-3.5 [.border-b]:pb-3.5 order-first w-full justify-start"
		case AlignBlockEnd:
			align = "pb-3 group-has-[>input]/input-group:pb-3.5 [.border-t]:pt-3.5 order-last w-full justify-start"
		}
	}}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		role="group"
		data-slot="input-group-addon"
		data-align={ string(p.Align) }
		class={ utils.CN("text-muted-foreground **:data-[slot=kbd]:bg-muted-foreground/10 h-auto gap-2 py-2 text-sm font-medium group-data-[disabled=true]/input-group:opacity-50 **:data-[slot=kbd]:rounded-none **:data-[slot=kbd]:px-1.5 [&>svg:not([class*='size-'])]:size-3.5 flex cursor-text items-center justify-center select-none"+align, p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// 1:1 the inputGroupButtonVariants cva from base/ui/input-group.tsx.
func inputGroupButtonClasses(size ButtonSize) string {
	base := "gap-2 rounded-none text-sm flex items-center shadow-none"
	switch size {
	case ButtonSizeSm:
		return base + ""
	case ButtonSizeIconXs:
		return base + "size-6 p-0 has-[>svg]:p-0 text-xs"
	case ButtonSizeIconSm:
		return base + "size-8 p-0 has-[>svg]:p-0"
	default:
		return base + "h-6 gap-1 rounded-none px-1.5 [&>svg:not([class*='size-'])]:size-3.5 text-xs"
	}
}

templ Button(props ...ButtonProps) {
	{{ var p ButtonProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Type == "" {
		{{ p.Type = button.TypeButton }}
	}
	if p.Variant == "" {
		{{ p.Variant = button.VariantGhost }}
	}
	if p.Size == "" {
		{{ p.Size = ButtonSizeXs }}
	}
	{{
		attrs := templ.Attributes{"data-size": string(p.Size)}
		for k, v := range p.Attributes {
			attrs[k] = v
		}
	}}
	@button.Button(button.Props{
		Type:       p.Type,
		Variant:    p.Variant,
		Disabled:   p.Disabled,
		Class:      utils.CN(inputGroupButtonClasses(p.Size), p.Class),
		Attributes: attrs,
	}) {
		{ children... }
	}
}

templ Text(props ...TextProps) {
	{{ var p TextProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<span
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.CN("text-muted-foreground gap-2 text-sm [&_svg:not([class*='size-'])]:size-3.5 flex items-center [&_svg]:pointer-events-none", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</span>
}
