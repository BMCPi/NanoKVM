package components

import (
	"github.com/pi-bmc/nanokvm-app/ui/components/badge"
	"github.com/pi-bmc/nanokvm-app/ui/components/button"
	"github.com/pi-bmc/nanokvm-app/ui/components/empty"
	"github.com/pi-bmc/nanokvm-app/ui/components/icon"
)

// VideoPanel is the HDMI view: a toolbar mirroring the serial console's, over
// a <video> element fed by WebRTC from /api/vm/video.
//
// The stream is pull-only. The BMC encodes for as long as someone is watching
// and stops when the last viewer disconnects, so this panel deliberately does
// not connect on page load — it connects when the HDMI tab is first shown and
// disconnects when the tab is left. On a 1 GHz single-core part, encoding for
// a tab nobody is looking at is not a rounding error.
// iceServersJSON is the RTCIceServer[] the browser should use, already
// marshalled. It rides on a data attribute rather than an inline script
// because templ escapes attribute values correctly for HTML and the browser
// undoes that on read, whereas the same JSON interpolated into a <script> body
// would come back with &quot; in it and fail to parse.
templ VideoPanel(iceServersJSON string) {
	@videoPanelStyles()
	<div id="video-pane" class="flex h-full min-h-0 flex-col">
		// The stage is the layout container. It owns whatever space the tab
		// gives it and centers the picture inside — the frame never stretches
		// to the pane, so a 4:3 host does not sit in a 16:9 letterbox with
		// chrome pinned to the black bars.
		<div id="video-stage" class="relative flex min-h-0 flex-1 items-center justify-center overflow-hidden bg-black/40 p-2" data-ice-servers={ iceServersJSON }>
			// The frame IS the picture box: its aspect ratio tracks the
			// stream's, so everything pinned to it lands on the video rather
			// than on letterbox. See videoPanelStyles for how it fits.
			<div id="video-frame" class="relative overflow-hidden rounded-lg bg-black shadow-2xl ring-1 ring-white/10">
				// muted + playsinline are what let autoplay through: a stream
				// with no audio track still counts as "with sound" to some
				// browsers unless muted is set, and the play() would be
				// rejected.
				<video id="video-stream" class="absolute inset-0 block h-full w-full object-contain" autoplay muted playsinline></video>
				@videoToolbar()
				@videoStatusFooter()
				@videoOverlay()
			</div>
		</div>
	</div>
	@videoPanelScript()
}

// videoToolbar is the discreet top chrome: the controls that change how the
// picture is presented, and nothing else. It floats over the video on a scrim
// rather than sitting in a bar above it, so the frame stays the whole panel.
//
// pointer-events-none on the strip with pointer-events-auto on the buttons:
// the scrim spans the full width for legibility, but only the controls should
// swallow clicks — the rest of that band is still video the operator may want
// to click through to the host.
templ videoToolbar() {
	<div id="video-toolbar" class="pointer-events-none absolute inset-x-0 top-0 z-10 flex justify-end bg-gradient-to-b from-black/70 via-black/25 to-transparent p-2 pb-6">
		<div class="pointer-events-auto flex items-center gap-1">
			@videoChromeButton("btn-video-mouse-mode", "toggleVideoMouseMode()",
				"Absolute pointing puts the host cursor under yours; relative captures the pointer for hosts that ignore an absolute one") {
				@icon.MousePointer2(icon.Props{Class: "size-4"})
				<span id="video-mouse-mode-label" class="text-[11px] font-medium">Absolute</span>
			}
			@videoChromeButton("btn-video-expand", "toggleVideoExpand()", "Expand video") {
				@icon.Maximize2(icon.Props{Class: "size-4"})
			}
			@videoChromeButton("btn-video-fullscreen", "toggleVideoFullscreen()", "Fullscreen") {
				@icon.Expand(icon.Props{Class: "size-4"})
			}
		</div>
	</div>
}

// videoStatusFooter carries what the old toolbar said about the connection —
// source, mode, state — plus the one action that ends the session. Transparent
// over the picture, on a scrim so the text survives a white host desktop.
templ videoStatusFooter() {
	<div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 flex items-end justify-between gap-3 bg-gradient-to-t from-black/70 via-black/25 to-transparent p-2 pt-6">
		<div class="flex min-w-0 items-center gap-2 text-[11px] text-white/70">
			<span class="font-medium text-white/90">HDMI</span>
			<span id="video-mode" class="truncate tabular-nums">—</span>
			// One dot + label per state, swapped by the hidden PROPERTY the
			// same way the badges were. A dot rather than a badge: the footer
			// sits over live video and a filled pill is a hole in the picture.
			@videoStatusPill("disconnected", "bg-destructive", "Disconnected", false)
			@videoStatusPill("connecting", "bg-yellow-500", "Connecting…", true)
			@videoStatusPill("connected", "bg-green-500", "Streaming", true)
			@videoStatusPill("nosignal", "bg-orange-500", "No signal", true)
		</div>
		<div class="pointer-events-auto shrink-0">
			// The only destructive control on the panel, and deliberately the
			// quietest thing in it: ending a session is a decision, not a
			// thing to be nudged into by a red button under the cursor.
			@button.Button(button.Props{
				ID:      "btn-video-disconnect",
				Variant: button.VariantGhost,
				Size:    button.SizeSm,
				Class:   "h-7 gap-1 bg-black/40 px-2 text-[11px] text-white/70 backdrop-blur-sm hover:bg-destructive/80 hover:text-white",
				Attributes: templ.Attributes{
					"onclick": "disconnectVideo()",
					"title":   "Stop streaming and release the encoder",
					"hidden":  true,
				},
			}) {
				@icon.X(icon.Props{Class: "size-3.5"})
				<span>Disconnect</span>
			}
		</div>
	</div>
}

// videoStatusPill is one connection state. Badge rather than a hand-rolled
// span: the variants, sizing and typography are the same ones every other
// status in this app uses, and a bespoke pill here would drift from them the
// first time the palette moves.
//
// Softened with a translucent background because this one sits over live
// video — the default solid fill punches a hole in the picture — but the
// component still owns the shape.
func videoStatusPillID(state string) string { return "video-status-" + state }

templ videoStatusPill(state, dot, label string, hidden bool) {
	@badge.Badge(badge.Props{
		ID:      videoStatusPillID(state),
		Variant: badge.VariantSecondary,
		Class:   "h-5 gap-1.5 border-white/10 bg-black/50 px-1.5 text-[10px] text-white/80 backdrop-blur-sm",
		Attributes: templ.Attributes{
			"hidden": hidden,
		},
	}) {
		<span class={ "size-1.5 shrink-0 rounded-full " + dot }></span>
		{ label }
	}
}

// videoOverlay covers the frame whenever there is nothing to watch, and holds
// the call to action for the state it is reporting. Connect lives here rather
// than in the toolbar: when the panel is dark, starting the stream is the only
// thing an operator wants, and the middle of the picture is where they are
// already looking.
templ videoOverlay() {
	<div id="video-overlay" class="absolute inset-0 z-20 flex items-center justify-center bg-black/80 p-4 backdrop-blur-sm">
		// The Empty component is exactly this shape — media, title,
		// description, one action — so the icon sizing, spacing and text
		// scale come from the same place as every other empty state here
		// rather than being re-guessed.
		@empty.Empty(empty.Props{Class: "w-full max-w-md border-0 bg-transparent p-0"}) {
			@empty.Header() {
				@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
					@icon.MonitorOff()
				}
				@empty.Title(empty.TitleProps{ID: "video-overlay-title"}) {
					HDMI not connected
				}
				@empty.Description(empty.DescriptionProps{ID: "video-overlay-detail"}) {
					Select Connect to start streaming the host&#39;s HDMI output.
				}
			}
			@empty.Content() {
				// Connect lives here rather than in the toolbar: when the
				// panel is dark, starting the stream is the only thing an
				// operator wants, and the middle of the picture is where they
				// are already looking.
				@button.Button(button.Props{
					ID:         "btn-video-connect",
					Size:       button.SizeSm,
					Attributes: templ.Attributes{"onclick": "connectVideo()"},
				}) {
					@icon.Plug(icon.Props{Class: "size-4"})
					<span>Connect</span>
				}
			}
		}
	</div>
}

// videoChromeButton is the shared look for the floating top controls: quiet
// until hovered, legible over any picture behind them.
templ videoChromeButton(id, onclick, title string) {
	@button.Button(button.Props{
		ID:      id,
		Variant: button.VariantGhost,
		Size:    button.SizeSm,
		Class:   "h-7 gap-1 bg-black/40 px-2 text-white/80 backdrop-blur-sm hover:bg-black/70 hover:text-white",
		Attributes: templ.Attributes{
			"onclick": onclick,
			"title":   title,
		},
	}) {
		{ children... }
	}
}

templ videoPanelStyles() {
	<style>
		/* The overlay is driven by a data attribute rather than a class so it
		   cannot collide with the tabs component, which owns the `hidden`
		   class on the panes above it. */
		#video-overlay[data-state="hidden"] { display: none; }

		/* Fit-contain, in CSS, for a container rather than a replaced element.
		   A plain aspect-ratio box cannot do this: with width:100% the height
		   is derived and then merely clamped by max-height, which letterboxes
		   instead of shrinking the width to match. Container query units give
		   the stage's own content box, so the frame can take the smaller of
		   "as wide as the stage" and "as wide as the stage is tall, times the
		   ratio" — which is exactly object-fit:contain, applied to the box.

		   Why the box and not just object-contain on the video: the toolbar,
		   the status footer and the overlay are pinned to this element. If it
		   stretched to the pane while the picture letterboxed inside it, every
		   one of them would float over black bars instead of over the video. */
		#video-stage { container-type: size; }
		#video-frame {
			--video-aspect: 1.7777778;
			aspect-ratio: var(--video-aspect);
			width: min(100cqw, calc(100cqh * var(--video-aspect)));
		}

		/* The top controls stay out of the way until wanted.
		   Written here rather than as Tailwind's group-hover utility for one
		   reason: Tailwind v4 emits hover variants inside
		   @media (hover:hover), which guards the REVEAL but not the HIDE. On
		   a touch device the opacity-0 would still apply and the reveal never
		   would, leaving fullscreen and the mouse-mode toggle permanently
		   invisible with no way to reach them. Keeping all three states — 
		   hidden, revealed, and the pointerless exception — in one block is
		   what makes that failure impossible to reintroduce by editing one
		   half of it. */
		#video-toolbar {
			opacity: 0;
			transition: opacity 150ms ease;
		}
		#video-frame:hover #video-toolbar,
		#video-frame:focus-within #video-toolbar { opacity: 1; }
		/* No hover on a touch screen, so never hide them there. */
		@media (hover: none) {
			#video-toolbar { opacity: 1; }
		}

		/* Expanded takes the whole viewport, matching the serial pane's own
		   expand so the two tabs behave the same way. */
		#video-pane.expanded {
			position: fixed;
			inset: 0;
			z-index: 40;
			background: var(--background);
		}
	</style>
}

// videoPanelScript speaks the five-message protocol in pkg/video/rtc/signal.go:
// the browser offers, the BMC answers, candidates trickle both ways, and the
// BMC pushes unsolicited state messages carrying signal/resolution.
//
// Wrapped in an IIFE for the same reason bmcTerminalScript is: this page loads
// several classic scripts into one global scope.
templ videoPanelScript() {
	<script>
		(function () {
			let pc = null;
			let vws = null;
			let connected = false;

			function el(id) { return document.getElementById(id); }

			// Mirrors setConnStatus in console_script: exactly one badge
			// visible, swapped via the hidden PROPERTY.
			function setVideoStatus(state) {
				['disconnected', 'connecting', 'connected', 'nosignal'].forEach((s) => {
					const b = el('video-status-' + s);
					if (b) b.hidden = (s !== state);
				});
				// Connect is in the overlay and Disconnect in the footer, so
				// the two are never on screen together and neither needs to
				// reason about the other.
				const c = el('btn-video-connect');
				const d = el('btn-video-disconnect');
				if (c) c.hidden = (state !== 'disconnected');
				if (d) d.hidden = (state === 'disconnected');
			}

			// The frame is aspect-locked so the chrome pinned to it lands on
			// the picture. Told rather than measured: the hub reports the
			// capture size before a frame has decoded, so the box is right
			// the first time instead of snapping when metadata lands.
			function setVideoAspect(w, h) {
				const f = el('video-frame');
				if (!f || !w || !h) return;
				f.style.setProperty('--video-aspect', String(w / h));
			}

			function setOverlay(title, detail) {
				const o = el('video-overlay');
				if (!o) return;
				if (title === null) {
					o.dataset.state = 'hidden';
					return;
				}
				o.dataset.state = 'shown';
				el('video-overlay-title').textContent = title;
				el('video-overlay-detail').textContent = detail || '';
			}

			// State pushed by the hub: Ready false means the bridge sees no
			// input. That is a normal condition for a BMC (host powered off,
			// cable out), so it is reported as its own state and not an error.
			//
			// Kept rather than acted on directly, because it and the peer
			// connection arrive in either order. The hub sends the current
			// state as soon as the socket opens -- before the browser has
			// negotiated anything -- and then only when the state actually
			// changes. A host that is sitting there quietly never changes it.
			// So acting only on arrival meant a session that connected
			// perfectly was left showing "Connecting…" indefinitely, because
			// the only state message it ever received was one it discarded
			// for arriving too early.
			let lastState = null;

			function onState(s) {
				if (!s) return;
				lastState = s;
				render();
			}

			// Draws whatever the two halves currently say. Safe to call from
			// either of them, in any order, as many times as they like.
			function render() {
				const s = lastState;
				if (s && s.Ready && s.Width && s.Height) {
					const fps = s.FramePerSecond ? ' @ ' + Math.round(s.FramePerSecond) + 'fps' : '';
					el('video-mode').textContent = s.Width + '×' + s.Height + fps;
					setVideoAspect(s.Width, s.Height);
				} else {
					el('video-mode').textContent = '—';
				}

				// Until the peer connection is up there is nothing to say
				// beyond what connectVideo already put on screen.
				if (!connected) return;

				if (!s) {
					// Connected, but the BMC has not said anything about the
					// capture yet. Distinct from "no signal": the difference
					// is whether we have been told, and saying so beats a
					// spinner that means nothing.
					setVideoStatus('connecting');
					setOverlay('Connected', 'Waiting for the BMC to report the capture state.');
					return;
				}
				if (s.Ready) {
					setVideoStatus('connected');
					setOverlay(null);
				} else {
					setVideoStatus('nosignal');
					setOverlay('No signal', s.Err || 'The host is not sending HDMI output. Check that it is powered on and the cable is connected.');
				}
			}

			function fail(title, detail) {
				teardown();
				setVideoStatus('disconnected');
				setOverlay(title, detail);
			}

			function teardown() {
				connected = false;
				lastState = null;
				// Whatever was held goes with the session: a key still down on
				// the host after the pane closes looks like broken hardware.
				window.hidReleaseAll?.();
				if (vws) { try { vws.close(); } catch (e) {} vws = null; }
				if (pc) { try { pc.close(); } catch (e) {} pc = null; }
				const v = el('video-stream');
				if (v) v.srcObject = null;
			}

			window.connectVideo = async function () {
				if (pc) return;
				setVideoStatus('connecting');
				setOverlay('Connecting…', 'Negotiating a WebRTC session with the BMC.');

				// No configured STUN/TURN is normal and not an error: a BMC and
				// its browser are usually on the same L2 segment, where host
				// candidates alone complete the connection.
				let iceServers = [];
				try { iceServers = JSON.parse(el('video-stage').dataset.iceServers || '[]'); } catch (e) {}

				pc = new RTCPeerConnection({ iceServers });

				// Receive-only: the BMC never wants media from the browser.
				pc.addTransceiver('video', { direction: 'recvonly' });

				pc.ontrack = (e) => {
					const v = el('video-stream');
					if (v && e.streams && e.streams[0]) v.srcObject = e.streams[0];
				};
				pc.onicecandidate = (e) => {
					if (!vws || vws.readyState !== WebSocket.OPEN) return;
					// End-of-candidates is the candidate field being absent, not
					// an empty one: handleCandidate treats nil as the terminator
					// and would otherwise hand pion a blank candidate string.
					// This is also the shape the BMC sends in the other
					// direction.
					const msg = e.candidate
						? { type: 'candidate', candidate: e.candidate.toJSON() }
						: { type: 'candidate' };
					vws.send(JSON.stringify(msg));
				};
				// The peer connection, not the answer, is what "connected"
				// means. An answer only says the two sides agree on what to
				// negotiate; media cannot arrive until ICE has actually found
				// a path, and on a network where it never does, treating the
				// answer as success leaves the UI claiming a working session
				// over a black frame.
				pc.onconnectionstatechange = () => {
					if (!pc) return;
					switch (pc.connectionState) {
						case 'connected':
							connected = true;
							render();
							break;
						case 'disconnected':
							// Transient by nature and usually self-healing, so
							// this reports rather than tears down. The BMC
							// gives it a bounded grace period and drops the
							// session if it does not come back.
							setVideoStatus('connecting');
							setOverlay('Reconnecting…', 'The media connection dropped. Waiting for it to recover.');
							break;
						case 'failed':
							fail('Connection failed', 'The WebRTC session could not be established. Check that the browser can reach the BMC directly or that a TURN server is configured.');
							break;
					}
				};

				vws = new WebSocket(getWsUrl() + '/api/vm/video');

				vws.onopen = async () => {
					try {
						const offer = await pc.createOffer();
						await pc.setLocalDescription(offer);
						vws.send(JSON.stringify({ type: 'offer', sdp: offer.sdp }));
					} catch (err) {
						fail('Negotiation failed', String(err));
					}
				};

				vws.onmessage = async (ev) => {
					let m;
					try { m = JSON.parse(ev.data); } catch (e) { return; }
					if (!pc) return;
					switch (m.type) {
						case 'answer':
							try {
								await pc.setRemoteDescription({ type: 'answer', sdp: m.sdp });
								// Negotiated, but not yet connected: ICE still
								// has to find a path. Say which of the two is
								// outstanding rather than leaving the earlier
								// "negotiating" text up, which is now wrong.
								setOverlay('Connecting…', 'Negotiated. Waiting for the media connection.');
							} catch (err) {
								fail('Negotiation failed', String(err));
							}
							break;
						case 'candidate':
							if (m.candidate && m.candidate.candidate) {
								try { await pc.addIceCandidate(m.candidate); } catch (e) {}
							}
							break;
						case 'state':
							onState(m.state);
							break;
						case 'error':
							fail('Video unavailable', m.error || 'The BMC reported an error starting the capture pipeline.');
							break;
					}
				};

				// The socket carries signaling only, but closing it is what ends
				// the session server-side, so a close before we are connected is
				// a real failure and after it is a normal teardown.
				vws.onclose = () => {
					if (!connected) {
						fail('Video unavailable', 'The BMC closed the signaling connection. HDMI capture may not be available on this device.');
					} else {
						teardown();
						setVideoStatus('disconnected');
						setOverlay('Disconnected', 'The video session ended.');
					}
				};
				vws.onerror = () => {
					if (!connected) fail('Video unavailable', 'Could not open the video signaling socket.');
				};
			};

			window.disconnectVideo = function () {
				teardown();
				setVideoStatus('disconnected');
				setOverlay('HDMI not connected', 'Select Connect to start streaming the host’s HDMI output.');
			};

			// Input capture is wired to the pane, not to the media session, so
			// the keyboard and pointer work at a host that is mid-POST with no
			// picture yet — which is exactly when an operator needs them.
			function attachInput() {
				window.hidAttach?.(el('video-frame'), el('video-stream'));
			}

			window.toggleVideoMouseMode = function () {
				const next = window.hidMouseMode?.() === 'relative' ? 'absolute' : 'relative';
				window.hidSetMouseMode?.(next);
			};

			// Kept in the input client so the label follows the mode however it
			// was changed (button, or pointer lock being lost).
			window.onHidMouseMode = function (mode) {
				const label = el('video-mouse-mode-label');
				if (label) label.textContent = mode === 'relative' ? 'Relative' : 'Absolute';
				const overlay = el('video-overlay');
				if (mode === 'relative' && overlay && overlay.dataset.state === 'hidden') {
					// Pointer lock needs a click to engage, and a captured
					// pointer with no hint is disorienting.
					el('video-frame')?.setAttribute('title', 'Click to capture the pointer; press Esc to release');
				} else {
					el('video-frame')?.removeAttribute('title');
				}
			};

			// Fullscreen the pane, not the frame: the stage inside it is what
			// centers the picture, and taking the frame alone would strand the
			// toolbar and footer on a box that no longer has a container to
			// measure against.
			window.toggleVideoFullscreen = function () {
				const p = el('video-pane');
				if (!p) return;
				if (document.fullscreenElement) document.exitFullscreen();
				else p.requestFullscreen?.();
			};

			// Expand mirrors the serial pane's: fill the viewport without
			// asking the browser for fullscreen, so the operator keeps their
			// tab strip and the BMC's own chrome one Escape away.
			window.toggleVideoExpand = function () {
				const p = el('video-pane');
				const b = el('btn-video-expand');
				if (!p) return;
				const on = p.classList.toggle('expanded');
				if (b) {
					b.classList.toggle('bg-black/70', on);
					b.title = on ? 'Collapse video' : 'Expand video';
				}
				const header = document.querySelector('header');
				if (header) header.style.display = on ? 'none' : '';
			};

			document.addEventListener('keydown', (e) => {
				if (e.key !== 'Escape') return;
				const p = el('video-pane');
				if (p && p.classList.contains('expanded') && !document.fullscreenElement) {
					window.toggleVideoExpand();
				}
			});

			// Called by the tab strip. Connecting lazily keeps the encoder idle
			// while the serial tab is in front.
			window.onVideoTabShown = function () {
				attachInput();
				if (!pc) connectVideo();
			};
			window.onVideoTabHidden = function () {
				if (pc) disconnectVideo();
			};

			// Attach on load rather than only on tab-show: hidAttach is
			// idempotent, and input has to work whether or not the operator has
			// ever opened the HDMI tab — the virtual keyboard and macros reach
			// the host through the same client.
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', attachInput);
			} else {
				attachInput();
			}

			window.addEventListener('beforeunload', () => { window.hidReleaseAll?.(); teardown(); });
		})();
	</script>
}
