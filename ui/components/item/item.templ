	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="item-content"
		class={ utils.CN("group-data-[size=xs]/item:gap-0 flex flex-1 flex-col [&+[data-slot=item-content]]:flex-none gap-1 min-w-0", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

