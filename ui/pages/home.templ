package pages

import (
	"github.com/pi-bmc/nanokvm-app/ui/components"
	"github.com/pi-bmc/nanokvm-app/ui/components/button"
	"github.com/pi-bmc/nanokvm-app/ui/components/buttongroup"
	"github.com/pi-bmc/nanokvm-app/ui/components/dropdownmenu"
	"github.com/pi-bmc/nanokvm-app/ui/components/icon"
	"github.com/pi-bmc/nanokvm-app/ui/components/resizable"
	"github.com/pi-bmc/nanokvm-app/ui/components/tabs"
	"github.com/pi-bmc/nanokvm-app/ui/layouts"
	"github.com/pi-bmc/nanokvm-app/ui/utils"
)

// consoleTabsID names the dashboard's tab group. Fixed rather than generated
// so the switch script and tabs.js can address it.
const consoleTabsID = "console-tabs"

// Panel ids for the dashboard split. Fixed rather than generated so the
// overview's open/close script can address its panel.
const (
	dashboardPanelsID = "dashboard-panels"
	overviewPanelID   = "overview-panel"
)

// Tab values. These are the same sentinels config.Console.PrimaryView stores,
// which is what lets the persisted setting select the initial tab directly.
const (
	tabHDMI   = "hdmi"
	tabSerial = "serial"
)

// Home is the main BMC page (served at /dashboard). Standard layout (navbar
// at top), then a horizontal flex row containing the console pane + the
// Server Overview sidebar. The sidebar's width animates between 0 and 24rem,
// so opening it shrinks the console pane rather than overlaying it or the
// navbar.
//
// The console pane is tabbed: the host can be watched over its serial console
// or its HDMI output, and both stay reachable regardless of which one the
// device is configured to open on. Only the default changes -- hiding the
// other tab outright would mean a headless box could never be checked for
// video, and a workstation could never be reached when its HDMI is dark, which
// are exactly the moments someone goes looking.
templ Home(m HomeModel) {
	@layouts.Base("NanoKVM BMC", true, false) {
		<link rel="stylesheet" href="/css/xterm.min.css"/>
		<style>
			#console-pane { display: flex; flex-direction: column; height: 100%; padding: 0; gap: 0; }
			#console-pane.expanded { position: fixed; inset: 0; z-index: 40; background: var(--background); padding: 0; }
			#terminal-wrap { flex: 1; min-height: 0; position: relative; overflow: hidden; }
			#terminal { height: 100%; }
			/* The tab group and its panes carry the pane's height down to the
			   terminal and the video, both of which measure themselves against
			   their container. flex-1 rather than height:100% because the group
			   is itself a flex item and only its parent has a definite height;
			   min-height:0 is what lets it shrink below its content instead of
			   overflowing the viewport. */
			#console-tabs { flex: 1; min-height: 0; height: 100%; }
			#console-tabs [data-tui-tabs-content] { min-height: 0; }
		</style>
		// The console and the overview share the width, with a drag handle
		// between them. The overview is a collapsible panel rather than a
		// fixed drawer: an operator comparing a boot screen against the
		// firmware state it came from wants both, at whatever split suits the
		// screen. Collapsed is still the default — it opens on request.
		@resizable.PanelGroup(resizable.PanelGroupProps{
			ID:          dashboardPanelsID,
			Orientation: resizable.OrientationHorizontal,
			Class:       "flex h-full min-h-0 w-full",
		}) {
			// Style overrides the panel content's default overflow:auto: the
			// console panes manage their own scrolling and a second scroll
			// container around them would let the toolbar slide away.
			@resizable.Panel(resizable.PanelProps{
				MinSize: "24rem",
				Class:   "flex min-w-0 flex-col h-full min-h-0",
				Style:   "overflow:hidden;",
			}) {
				@tabs.Tabs(tabs.Props{
					ID:           consoleTabsID,
					DefaultValue: consoleDefaultTab(m),
					Class:        "gap-0 h-full min-h-0 flex-1",
				}) {
					// Contextual Secondary Sub-Navbar (JetKVM 2-Tier Pattern)
					<div class="flex items-center justify-between border-b border-border bg-card/60 backdrop-blur-xs px-2.5 py-1.5 gap-2 shrink-0">
						// Left: the view switcher.
						@consoleViewSwitch()
						// Right: Session Action Controls (Virtual Media, Macros, Virtual Keyboard)
						<div class="flex items-center gap-1 shrink-0">
							@components.VirtualMediaMenu()
							@components.MacroBar()
							@button.Button(button.Props{
								ID:      "btn-virtual-keyboard",
								Variant: button.VariantGhost,
								Size:    button.SizeSm,
								Attributes: templ.Attributes{
									"onclick":       "toggleVirtualKeyboard()",
									"aria-label":    "Virtual Keyboard",
									"aria-expanded": "false",
									"title":         "Virtual keyboard",
								},
							}) {
								@icon.Keyboard()
								<span class="hidden sm:inline">Keyboard</span>
							}
						</div>
					</div>
					// Main Console Viewports (Padding-free, edge-to-edge)
					<div class="flex-1 min-h-0 p-2">
						@tabs.Content(tabs.ContentProps{Value: tabHDMI, Class: "h-full min-h-0"}) {
							@components.VideoPanel(m.ICEServersJSON)
						}
						@tabs.Content(tabs.ContentProps{Value: tabSerial, Class: "h-full min-h-0"}) {
							<div id="console-pane">
								@components.ConsoleToolbar()
								<div id="terminal-wrap" class="border border-t-0 border-border bg-background rounded-b-md">
									<div id="terminal"></div>
								</div>
							</div>
						}
					</div>
				}
			}
			@resizable.Handle(resizable.HandleProps{WithHandle: true})
			// Starts at 0% — collapsed — so the dashboard opens on the
			// console alone, as it always has. The first expand lands on
			// MinSize; the width chosen after that is carried across close
			// and reopen by overviewToggleScript, which tracks it because
			// the panel only remembers a width it collapsed itself.
			@resizable.Panel(resizable.PanelProps{
				ID:            overviewPanelID,
				Collapsible:   true,
				CollapsedSize: "0%",
				DefaultSize:   "0%",
				MinSize:       "20rem",
				MaxSize:       "48rem",
				Style:         "overflow:hidden;",
			}) {
				@components.OverviewSidebar()
			}
		}
		@xtermScripts()
		// The HID input client: keycode table, input socket, and the capture
		// handlers the HDMI pane and the virtual keyboard both send through.
		@components.HIDInput()
		@components.ConsoleScript()
		@consoleTabsScript()
		// Slide-up shell drawer for the BMC itself. Rendered after the
		// xterm bundles so its script can construct a Terminal at once.
		@components.BMCTerminalPanel()
	}
}

// consoleDefaultTab maps the persisted setting onto the tab that opens.
func consoleDefaultTab(m HomeModel) string {
	if m.HDMIPrimary {
		return tabHDMI
	}
	return tabSerial
}

// consoleTabsScript tells each pane when it comes to the front.
//
// tabs.js only toggles classes; it has no notion that a pane owns a live
// connection. Both panes do: xterm needs a refit once it has a non-zero box
// (fitting a display:none element yields garbage dimensions), and the video
// pane starts and stops encoding on the BMC. Encoding for a hidden tab would
// burn the SoC's only core on frames nobody is looking at, so leaving the tab
// is a disconnect, not just a style change.
templ consoleTabsScript() {
	<script>
		(function () {
			let current = null;

			function activeTab() {
				const t = document.querySelector('[data-tui-tabs-trigger][data-tui-tabs-id="console-tabs"][data-active]');
				return t ? t.getAttribute('data-tui-tabs-value') : null;
			}

			function sync() {
				const next = activeTab();
				if (!next || next === current) return;
				const prev = current;
				current = next;

				if (prev === 'hdmi') window.onVideoTabHidden?.();

				if (next === 'hdmi') {
					window.onVideoTabShown?.();
				} else if (next === 'serial') {
					// The terminal was laid out against a zero-height box while
					// hidden; refit now that it has real dimensions.
					window.fitTerminal?.();
				}
			}

			// tabs.js handles the click and flips the attributes; this runs
			// after it on the same event, reading the state it just set.
			document.addEventListener('click', (e) => {
				if (!e.target.closest('[data-tui-tabs-trigger][data-tui-tabs-id="console-tabs"]')) return;
				setTimeout(sync, 0);
			});

			document.addEventListener('DOMContentLoaded', () => setTimeout(sync, 0));
		})();
	</script>
}

// xtermScripts loads the xterm.js bundles. Kept separate so the dashboard
// markup stays readable.
templ xtermScripts() {
	<script src="/js/xterm.min.js"></script>
	<script src="/js/xterm-addon-fit.min.js"></script>
	<script src="/js/xterm-addon-attach.min.js"></script>
	<script src="/js/xterm-addon-search.min.js"></script>
}

// consoleViewSwitch chooses which console is in the main pane, and carries the
// third console — the shell on the BMC itself — behind the chevron.
//
// The two panes stay tabs.Triggers rather than becoming plain buttons that
// call into tabs.js: the trigger is what tabs.js marks data-active on, so the
// group shows which pane is front for free. Its List-oriented base classes
// (flex-1, full-height, transparent border) are overridden here because the
// group, not a tabs.List, is providing the frame now.
//
// The BMC shell is a dropdown item rather than a fourth button because it is
// not a view of the main pane at all — it opens a drawer over the bottom of
// the page. Grouping it here anyway keeps every console in one control.
templ consoleViewSwitch() {
	@dropdownmenu.DropdownMenu() {
		@buttongroup.ButtonGroup() {
			@tabs.Trigger(tabs.TriggerProps{
				Value: tabHDMI,
				Class: consoleSwitchTabClass,
			}) {
				@icon.Monitor(icon.Props{Class: "size-3.5"})
				<span>HDMI</span>
			}
			@buttongroup.ButtonGroup() {
				@tabs.Trigger(tabs.TriggerProps{
					Value: tabSerial,
					Class: consoleSwitchTabClass,
				}) {
					@icon.Terminal(icon.Props{Class: "size-3.5"})
					<span>Serial Console</span>
				}
				// Welding drops the left border of every child after the
				// first, so without this the chevron reads as part of the
				// Serial Console button rather than its own target.
				@buttongroup.Separator()
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Class:   "h-8 px-2!",
					Attributes: utils.MergeAttributes(
						dropdownmenu.Trigger(ctx),
						templ.Attributes{
							"aria-label": "More consoles",
							"title":      "Other consoles",
						},
					),
				}) {
					@icon.ChevronDown()
				}
			}
		}
		@dropdownmenu.Content(dropdownmenu.ContentProps{Class: "w-52"}) {
			// Keeps the id the drawer script marks active and sets
			// aria-expanded on (see bmc_terminal.templ setNavActive).
			@dropdownmenu.Item(dropdownmenu.ItemProps{
				ID: "btn-bmc-terminal",
				Attributes: templ.Attributes{
					"onclick":       "toggleBmcTerminal()",
					"aria-expanded": "false",
					"title":         "Shell on the BMC",
				},
			}) {
				@icon.SquareTerminal()
				BMC Terminal
			}
		}
	}
}

// consoleSwitchTabClass renders a tab trigger as a button inside the group.
// The trigger's own base is written for a tabs.List — it stretches to the
// list's height and draws a transparent border — so the height, the border
// and the flex-1 all have to be restated here.
const consoleSwitchTabClass = "h-8 flex-none px-3 text-xs gap-1.5 border-border data-active:bg-accent data-active:text-accent-foreground"
