package pages

// authHelperScript is the JavaScript the two auth pages share. It used to
// live in layouts.Base and ship with every page; only login and password
// still submit through fetch() (see the rationale on their scripts), so only
// they render it now.
//
// The trimmed surface is exactly what those two forms use: setCookie (login
// stores the token the JSON API returns), deleteCookie (password drops the
// session before bouncing to login), and encryptPassword (the stock NanoKVM
// API expects the password AES-encrypted client-side with this fixed key —
// an upstream compatibility contract, not a security boundary).
templ authHelperScript() {
	<script>
		function setCookie(name, value, days) {
			const d = new Date();
			d.setTime(d.getTime() + (days * 24 * 60 * 60 * 1000));
			document.cookie = name + '=' + encodeURIComponent(value) + ';expires=' + d.toUTCString() + ';path=/';
		}
		function deleteCookie(name) {
			document.cookie = name + '=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/';
		}
		function encryptPassword(password) {
			const SECRET_KEY = 'nanokvm-sipeed-2024';
			const encrypted = CryptoJS.AES.encrypt(password, SECRET_KEY).toString();
			return encodeURIComponent(encrypted);
		}
	</script>
}
