package pages

import (
	"github.com/pi-bmc/nanokvm-app/ui/components"
	"github.com/pi-bmc/nanokvm-app/ui/layouts"
)

// Bios is the host BIOS configuration page (served at /bios).
//
// A page rather than a settings-dialog panel because the two configure
// different machines: the settings dialog is the BMC's own configuration,
// while everything here belongs to the managed host and is only staged by the
// BMC. The volume differs too — a real EDK2 attribute registry runs to
// hundreds of attributes across a menu tree, which needs a rail and a search
// box rather than a modal's scroll pane.
templ Bios(m components.BiosModel) {
	@layouts.Base("BIOS Configuration — NanoKVM BMC", true, false) {
		@components.BiosPage(m)
	}
}
